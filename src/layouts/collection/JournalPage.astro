---
import Base from '../Base.astro';
import JournalCard from '../../components/JournalCard.astro';
import { fmtDate, titleOf, describe, entryUrl, indexUrl, type Journal, type CollectionConfig } from '../../lib/collections';

interface Props {
  config: CollectionConfig;
  entry: Journal;
  newer?: Journal;
  older?: Journal;
}
const { config, entry, newer, older } = Astro.props;
const title = titleOf(entry);
const description = describe(entry) || title;
const indexTitle = [config.title, config.accent].filter(Boolean).join(' ');
---

<Base title={title} description={description} type="article" publishedTime={entry.data.date}>
  <div class="page">
    <a class="mono back" href={`${indexUrl(config.name)}#d-${entry.id}`}>← {indexTitle}</a>
    <h1 class="kicker">{title}</h1>
    <JournalCard entry={entry} link={false} />
    <nav class="pager" aria-label="More entries">
      {
        older ? (
          <a class="pager-card" href={entryUrl(older)}>
            <span class="mono muted">← Older</span>
            <span class="pager-title">{fmtDate(older.data.date)}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        newer ? (
          <a class="pager-card next" href={entryUrl(newer)}>
            <span class="mono muted">Newer →</span>
            <span class="pager-title">{fmtDate(newer.data.date)}</span>
          </a>
        ) : (
          <a class="pager-card next" href={indexUrl(config.name)}>
            <span class="mono muted">Latest</span>
            <span class="pager-title">Back to {indexTitle}</span>
          </a>
        )
      }
    </nav>
  </div>
</Base>

<style>
  .page {
    width: min(var(--measure), 100% - 2.5rem);
    margin: 0 auto;
    padding: 8rem 0 6rem;
  }
  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    text-decoration: none;
    color: var(--muted);
  }
  h1 {
    margin: 0 0 1.2rem;
    font-weight: 400;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .pager-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.2rem 1.4rem;
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-panel);
    text-decoration: none;
    transition:
      border-color 0.3s,
      transform 0.4s var(--ease);
  }
  .pager-card:hover {
    color: var(--ink);
    border-color: var(--accent);
    transform: translateY(var(--lift-lg));
  }
  .pager-card.next {
    text-align: right;
  }
  .pager-title {
    font-family: var(--serif);
    font-size: 1.25rem;
  }
</style>
