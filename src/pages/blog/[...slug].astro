---
import Redirect from '../../components/Redirect.astro';
import { url } from '../../lib/url';

export function getStaticPaths() {
  // The only posts that were ever published under /blog/.
  return ['the-beginning', 'sma-implementation', 'derivatives-implementation', 'the-crash'].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<Redirect to={url(`/projects/${slug}/`)} />
