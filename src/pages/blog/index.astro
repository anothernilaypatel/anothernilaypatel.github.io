---
import Base from '../../layouts/Base.astro';
import MarketField from '../../components/MarketField.astro';
import Sparkline from '../../components/Sparkline.astro';
import { getPosts, fmtDate, readingTime } from '../../lib/posts';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const series = [...new Set(posts.map((p) => p.data.series).filter(Boolean))];
---

<Base title="Research log" description="Nilay Patel's research log: building a hedge fund from scratch, FX backtests, momentum signals, and post-mortems.">
  <section class="head">
    <MarketField paths={22} seed={19} />
    <div class="head-veil" aria-hidden="true"></div>
    <div class="wrap head-inner">
      <a class="mono back" href="/">← Home</a>
      <p class="kicker">anothernilaypatel / research log</p>
      <h1>Research <em>log</em></h1>
      <p class="lede">
        Notes from building a hedge fund from scratch as a student: data sources, backtests, signals that worked, and the things that broke.
      </p>
      <dl class="meta mono">
        <div><dt class="muted">Entries</dt><dd>{posts.length}</dd></div>
        <div><dt class="muted">Series</dt><dd>{series.length}</dd></div>
        <div><dt class="muted">Since</dt><dd>{posts.at(-1) && fmtDate(posts.at(-1)!.data.date)}</dd></div>
        <div><dt class="muted">Feed</dt><dd><a href="/rss.xml">RSS ↗</a></dd></div>
      </dl>
    </div>
  </section>

  <section class="wrap list-wrap" aria-label="Posts">
    <div class="filters" role="group" aria-label="Filter by tag" data-filters hidden>
      <button type="button" class="chip mono" aria-pressed="true" data-tag="">All</button>
      {
        tags.map((t) => (
          <button type="button" class="chip mono" aria-pressed="false" data-tag={t}>
            #{t}
          </button>
        ))
      }
    </div>

    <ol class="posts" data-posts>
      {
        posts.map((p, i) => {
          return (
            <li class="post" data-reveal data-tags={p.data.tags.join(' ')} style={`--d:${i}`}>
              <a href={`/blog/${p.id}/`} class="post-link" data-spot>
                <span class="post-num mono" aria-hidden="true">
                  {String(p.data.seriesPart ?? posts.length - i).padStart(2, '0')}
                </span>
                <span class="post-main">
                  <span class="post-meta mono muted">
                    <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
                    <span>· {readingTime(p.body)} min</span>
                    {p.data.series && <span class="post-series">· {p.data.series} {p.data.seriesPart && `pt. ${p.data.seriesPart}`}</span>}
                  </span>
                  <span class="post-title">{p.data.title}</span>
                  <span class="post-summary">{p.data.summary}</span>
                  <span class="post-tags mono">
                    {p.data.tags.map((t) => (
                      <span>#{t}</span>
                    ))}
                  </span>
                </span>
                <span class="post-chart" aria-hidden="true">
                  <Sparkline seed={p.id} width={180} height={56} />
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
    <p class="empty muted mono" data-empty hidden>No entries with that tag yet.</p>
  </section>
</Base>

<style>
  .head {
    position: relative;
    overflow: hidden;
    padding: 8.5rem 0 4rem;
    border-bottom: 1px solid var(--line);
  }
  .head-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 80% at 15% 60%, color-mix(in srgb, var(--bg) 88%, transparent), transparent 75%),
      linear-gradient(to bottom, transparent 60%, var(--bg));
  }
  .head-inner {
    position: relative;
  }
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    text-decoration: none;
    color: var(--muted);
  }
  h1 {
    font-size: clamp(3.5rem, 12vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin: 1rem 0 1.5rem;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
  }
  h1 em {
    color: var(--accent);
  }
  .lede {
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.45;
    max-width: 38rem;
    color: var(--ink-2);
    margin: 0 0 2.5rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0;
  }
  .meta dd {
    margin: 0.2rem 0 0;
    color: var(--ink);
  }
  .meta a {
    text-decoration: none;
    color: var(--accent);
  }

  .list-wrap {
    padding: 3rem 0 6rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .filters[hidden] {
    display: none;
  }
  .chip {
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-2);
    font-size: 0.7rem;
    cursor: pointer;
    transition: all 0.25s var(--ease);
  }
  .chip:hover {
    border-color: var(--ink-2);
    color: var(--ink);
  }
  .chip[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .post[hidden] {
    display: none;
  }
  .post-link {
    position: relative;
    display: grid;
    grid-template-columns: 5rem 1fr 190px;
    gap: 2rem;
    align-items: center;
    padding: 2.2rem 1rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
  }
  .post-link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(500px circle at var(--mx, -100%) var(--my, 50%), color-mix(in srgb, var(--accent) 10%, transparent), transparent 45%);
    transition: opacity 0.3s;
    opacity: 0;
  }
  .post-link:hover::before,
  .post-link:focus-visible::before {
    opacity: 1;
  }
  .post-link:hover {
    color: var(--ink);
  }
  .post-num {
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--muted);
    transition:
      color 0.4s var(--ease),
      -webkit-text-stroke-color 0.4s var(--ease);
  }
  .post-link:hover .post-num {
    color: var(--accent);
    -webkit-text-stroke-color: var(--accent);
  }
  .post-main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.7rem;
  }
  .post-title {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 3.4vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    transition: transform 0.5s var(--ease);
  }
  .post-link:hover .post-title {
    transform: translateX(6px);
  }
  .post-summary {
    color: var(--ink-2);
    max-width: 40rem;
  }
  .post-tags {
    display: flex;
    gap: 0.8rem;
    font-size: 0.68rem;
    color: var(--accent);
    text-transform: none;
  }
  .post-chart {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    opacity: 0.55;
    transition: opacity 0.4s var(--ease);
  }
  .post-link:hover .post-chart {
    opacity: 1;
  }
  .empty {
    padding: 2rem 0;
  }

  @media (max-width: 760px) {
    .post-link {
      grid-template-columns: 1fr;
      gap: 0.8rem;
      padding: 1.8rem 0.25rem;
    }
    .post-num {
      font-size: 2rem;
    }
    .post-chart {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      opacity: 0.8;
    }
    .post-chart :global(svg) {
      width: 50%;
    }
  }
</style>

<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]')!;
  const items = [...document.querySelectorAll<HTMLElement>('[data-posts] > li')];
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const chips = [...filters.querySelectorAll<HTMLButtonElement>('[data-tag]')];
  filters.hidden = false;

  const apply = (tag: string) => {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.tag === tag)));
    let shown = 0;
    for (const li of items) {
      const match = !tag || li.dataset.tags!.split(' ').includes(tag);
      li.hidden = !match;
      if (match) {
        shown++;
        li.classList.add('is-in');
      }
    }
    empty.hidden = shown > 0;
    const url = new URL(location.href);
    tag ? url.searchParams.set('tag', tag) : url.searchParams.delete('tag');
    history.replaceState(null, '', url);
  };
  chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.tag!)));
  const initial = new URL(location.href).searchParams.get('tag');
  if (initial && chips.some((c) => c.dataset.tag === initial)) apply(initial);

  document.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${e.clientX - r.left}px`);
      el.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
