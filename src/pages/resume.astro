---
import Base from '../layouts/Base.astro';
import { site, contact } from '../site.config';
import { url, absoluteUrl, href } from '../lib/url';

// Built from site.config.ts, the same data as the home page, so the two can't disagree.
// The deploy prints this page to /resume.pdf (scripts/resume-pdf.mjs).

const bullets = (text: string) => text.split(/(?<=\.)\s+(?=[A-Z])/).filter(Boolean);
const link = (path: string) => (path.startsWith('/') ? absoluteUrl(path, Astro.site!) : href(path));
const bare = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
const home = absoluteUrl('/', Astro.site!);

// `bulleted` splits the detail into one bullet per sentence; otherwise it stays one line.
type Entry = { head: string; sub: string; period: string; detail: string; points?: string[]; href: string };
const sections: { title: string; bulleted: boolean; items: Entry[] }[] = [
  {
    title: 'Experience',
    bulleted: true,
    items: site.experience.map((e) => ({ head: e.role, sub: e.org, period: e.period, detail: e.detail, points: e.points, href: e.href })),
  },
  {
    title: 'Quantitative projects',
    bulleted: true,
    items: site.projects.map((e) => ({ head: e.role, sub: e.org, period: e.period, detail: e.detail, points: e.points, href: e.href })),
  },
  {
    title: 'Education',
    bulleted: false,
    items: site.education.map((e) => ({ head: e.school, sub: e.credential, period: e.period, detail: e.detail, href: '' })),
  },
  {
    title: 'Hackathons',
    bulleted: true,
    items: site.startups.map((e) => ({ head: e.role, sub: e.org, period: e.period, detail: e.detail, points: e.points, href: e.href })),
  },
  {
    title: 'Competitions',
    bulleted: false,
    items: site.competitions.map((e) => ({ head: e.role, sub: e.org, period: e.period, detail: e.detail, href: e.href })),
  },
].filter((s) => s.items.length > 0);

const contacts = [
  contact.email && { label: contact.email, href: `mailto:${contact.email}` },
  contact.linkedin && { label: 'LinkedIn', href: contact.linkedin },
  { label: bare(home), href: home },
].filter(Boolean) as { label: string; href: string }[];
---

<Base title="Résumé" description={`Résumé: ${site.description}`}>
  <div class="viewer">
    <div class="wrap toolbar">
      <a class="btn" href={url('/')}><span class="arrow back" aria-hidden="true">←</span> Back</a>
      <div class="toolbar-actions">
        <a class="btn btn-primary" href={url('/resume.pdf')} download="nilay-patel-resume.pdf">
          Download PDF <span class="arrow" aria-hidden="true">↓</span>
        </a>
        <button type="button" class="btn" data-print>Print <span class="arrow" aria-hidden="true">⎙</span></button>
      </div>
    </div>

    <article class="sheet" aria-label={`${site.name} résumé`}>
      <header class="r-head">
        <h1>{site.name}</h1>
        <p class="r-title">{contact.title}{contact.org && `, ${contact.org}`}</p>
        <ul class="r-contact">
          {contacts.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ul>
      </header>

      <p class="r-summary">{site.description}</p>

      {
        sections.map((s) => (
          <section class="r-section">
            <h2>{s.title}</h2>
            {s.items.map((it) => (
              <div class="r-item">
                <div class="r-line">
                  <h3>
                    {it.href ? <a href={link(it.href)}>{it.head}</a> : it.head}
                    {it.sub && <span class="r-sub">{it.sub}</span>}
                    {!s.bulleted && it.detail.length <= 60 && <span class="r-sub">{it.detail}</span>}
                  </h3>
                  <span class="r-period">{it.period}</span>
                </div>
                {(it.points || (it.detail && (s.bulleted || it.detail.length > 60))) &&
                  (s.bulleted ? (
                    <ul class="r-bullets">
                      {(it.points ?? bullets(it.detail)).map((b) => <li>{b}</li>)}
                    </ul>
                  ) : (
                    <p class="r-detail">{it.detail}</p>
                  ))}
              </div>
            ))}
          </section>
        ))
      }

      {
        site.skills.length > 0 && (
          <section class="r-section">
            <h2>Skills</h2>
            <dl class="r-skills">
              {site.skills.map((g) => (
                <div>
                  <dt>{g.group}</dt>
                  <dd>{g.items.join(', ')}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }
    </article>
  </div>
</Base>

<style>
  .viewer {
    padding: 6.5rem 0 clamp(3rem, 8vw, 6rem);
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .toolbar-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn:hover .arrow.back {
    transform: translateX(-4px);
  }

  /* The sheet is always ink on paper, whatever the site theme. */
  .sheet {
    --r-ink: #16181a;
    --r-ink-2: #3b3f42;
    --r-muted: #6c6f68;
    --r-accent: #9a5208;
    --r-line: #d8d1c0;
    width: min(8.5in, 100% - 1.5rem);
    margin: 0 auto;
    padding: clamp(1.4rem, 5vw, 0.6in);
    background: #fffdf8;
    color: var(--r-ink);
    border-radius: 6px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.12),
      0 24px 60px -20px rgb(0 0 0 / 0.45);
    font-family: var(--sans);
    font-size: 10pt;
    line-height: 1.32;
  }
  .sheet a {
    color: inherit;
    text-decoration-color: var(--r-line);
    text-underline-offset: 2px;
  }
  .sheet a:hover {
    color: var(--r-accent);
  }
  .r-head h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: 24pt;
    line-height: 1;
    letter-spacing: -0.02em;
    font-weight: 500;
  }
  .r-title {
    margin: 0.35rem 0 0;
    font-family: var(--serif);
    font-size: 13pt;
    color: var(--r-accent);
  }
  .r-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    font-size: 9.5pt;
    color: var(--r-ink-2);
  }
  .r-summary {
    margin: 0.8rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--r-line);
    color: var(--r-ink-2);
  }
  .r-section {
    margin-top: 0.85rem;
  }
  .r-section h2 {
    margin: 0 0 0.35rem;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid var(--r-line);
    font-family: var(--mono);
    font-size: 8.5pt;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--r-accent);
  }
  .r-item + .r-item {
    margin-top: 0.45rem;
  }
  .r-item {
    break-inside: avoid;
  }
  .r-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.4rem 1rem;
  }
  .r-line h3 {
    margin: 0;
    font-family: var(--sans);
    font-size: 10pt;
    font-weight: 650;
    line-height: 1.35;
  }
  .r-sub {
    font-weight: 400;
    color: var(--r-ink-2);
  }
  .r-sub::before {
    content: ' · ';
    color: var(--r-muted);
  }
  .r-period {
    flex: none;
    font-size: 9pt;
    color: var(--r-muted);
    font-variant-numeric: tabular-nums;
  }
  .r-detail {
    margin: 0.1rem 0 0;
    color: var(--r-ink-2);
  }
  .r-bullets {
    margin: 0.15rem 0 0;
    padding-left: 1.1rem;
    color: var(--r-ink-2);
  }
  .r-bullets li + li {
    margin-top: 0.05rem;
  }
  .r-skills {
    display: grid;
    gap: 0.15rem;
    margin: 0;
  }
  .r-skills div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.75rem;
  }
  .r-skills dt {
    font-weight: 650;
  }
  .r-skills dd {
    margin: 0;
    color: var(--r-ink-2);
  }

  @media (max-width: 560px) {
    .r-line {
      flex-direction: column;
    }
    .r-skills div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  @page {
    size: letter;
    margin: 0.4in 0.45in;
  }
  @media print {
    :global(.nav),
    :global(.foot),
    :global(.skip),
    .toolbar {
      display: none !important;
    }
    :global(html),
    :global(body) {
      background: #fff !important;
    }
    :global(body::before) {
      display: none !important;
    }
    .viewer {
      padding: 0;
    }
    .sheet {
      width: auto;
      padding: 0;
      box-shadow: none;
      border-radius: 0;
      background: #fff;
      font-size: 9.5pt;
      line-height: 1.27;
    }
    .r-head h1 {
      font-size: 22pt;
    }
    .r-title {
      font-size: 12pt;
      margin-top: 0.2rem;
    }
    .r-contact {
      margin-top: 0.35rem;
    }
    .r-summary {
      margin-top: 0.55rem;
      padding-top: 0.45rem;
    }
    .r-section {
      margin-top: 0.6rem;
    }
    .r-section h2 {
      margin-bottom: 0.25rem;
    }
    .r-item + .r-item {
      margin-top: 0.3rem;
    }
    .r-line h3 {
      font-size: 9.5pt;
    }
    .r-period {
      font-size: 8.5pt;
    }
    .r-bullets {
      margin-top: 0.05rem;
    }
    .r-bullets li + li {
      margin-top: 0;
    }
  }
</style>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
