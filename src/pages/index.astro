---
import Base from '../layouts/Base.astro';
import MarketField from '../components/MarketField.astro';
import Sparkline from '../components/Sparkline.astro';
import Highlights from '../components/home/Highlights.astro';
import Timeline from '../components/home/Timeline.astro';
import Interests from '../components/home/Interests.astro';
import { site, isPlaceholder, visibleLinks } from '../site.config';
import { getPosts, postUrl, kindLabel } from '../lib/posts';
import { url, href } from '../lib/url';

const posts = await getPosts();
const hobbyIds = new Set(posts.filter((p) => p.data.kind === 'hobby').map((p) => p.id));
const accoladeIds = new Set(posts.filter((p) => p.data.kind === 'accolade').map((p) => p.id));
const sprintPosts = posts.filter((p) => p.data.kind === 'sprint');
const published = new Set(posts.map((p) => p.id));

const timeline = [
  {
    label: 'Intern',
    items: site.experience.map((e) => ({ title: e.role, sub: e.org, period: e.period, detail: e.detail, href: e.href })),
  },
  {
    label: 'Hackathons',
    items: site.startups.map((e) => ({ title: e.role, sub: e.org, period: e.period, detail: e.detail, href: e.href })),
  },
  {
    label: 'Competitions',
    items: site.competitions.map((e) => ({ title: e.role, sub: e.org, period: e.period, detail: e.detail, href: e.href })),
  },
  {
    label: 'Education',
    items: site.education.map((e) => ({ title: e.school, sub: e.credential, period: e.period, detail: e.detail })),
  },
].filter((g) => g.items.length > 0);

const interests = site.interests
  .filter((i) => !i.post || hobbyIds.has(i.post))
  .map((i) => ({
    ...i,
    href: i.post && published.has(i.post) ? url(`/projects/${i.post}/`) : undefined,
  }));

const highlights = site.highlights
  .map((group) => ({
    ...group,
    items: group.items
      .filter((h) => {
        const slug = h.href?.match(/^\/projects\/([^/]+)\/?$/)?.[1];
        return !slug || accoladeIds.has(slug);
      })
      .map((h) => {
        const slug = h.href?.match(/^\/projects\/([^/]+)\/?$/)?.[1];
        return slug && !published.has(slug) ? { ...h, href: '' } : h;
      }),
  }))
  .filter((group) => group.items.length > 0);

const show = {
  about: site.about.length > 0,
  highlights: highlights.length > 0,
  path: timeline.length > 0,
  interests: interests.length > 0,
  latest: true,
  contact: visibleLinks.length > 0 || !!site.resume,
};
const order = (Object.keys(show) as (keyof typeof show)[]).filter((k) => show[k]);
const num = (k: keyof typeof show) => String(order.indexOf(k) + 1).padStart(2, '0');
const resumeHref = site.resume ? href(site.resume) : '';
const [first, ...rest] = site.name.split(' ');
---

<Base>
  <section class="hero" data-hero>
    <MarketField converge paths={36} />
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="kicker hero-kicker">{site.handle} · about me</p>
      <h1 class="hero-name">{first}<br /><span>{rest.join(' ')}</span></h1>
      <p class="hero-tag">{site.tagline}</p>
      {
        site.currently && (
          <p class:list={['mono', 'hero-now', { ph: isPlaceholder(site.currently) }]}>
            <span class="now-dot" aria-hidden="true" />
            Currently: {site.currently}
          </p>
        )
      }
      <div class="hero-cta">
        <a class="btn btn-primary" href={url('/projects/')}>Hobbies, sprints &amp; accolades <span class="arrow" aria-hidden="true">→</span></a>
        {resumeHref && <a class="btn" href={resumeHref}>Résumé (PDF) <span class="arrow" aria-hidden="true">↓</span></a>}
      </div>
    </div>
    <div class="wrap hero-foot mono muted" aria-hidden="true">
      <span>scroll</span>
      <span class="scroll-line"></span>
      <span class="hero-note">signal ← noise</span>
    </div>
  </section>

  {
    show.about && (
      <section id="about" class="about" aria-labelledby="about-h">
        <div class="wrap about-inner">
          <p class="kicker" data-reveal>
            {num('about')} / About
          </p>
          <div>
            <h2 id="about-h" data-reveal>
              Hi, I'm {first}.
            </h2>
            {site.about.map((p, i) => (
              <p class:list={['bio', { ph: isPlaceholder(p) }]} data-reveal style={`--d:${i + 1}`}>
                {p}
              </p>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {show.highlights && <Highlights groups={highlights} n={num('highlights')} />}
  {show.path && <Timeline groups={timeline} n={num('path')} />}
  {show.interests && <Interests items={interests} n={num('interests')} />}

  {
    show.latest && (
      <section id="latest" class="latest" aria-labelledby="latest-h">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="kicker">{num('latest')} / Latest</p>
            <h2 id="latest-h">Lately.</h2>
          </header>
          <div data-reveal>
            <p class="mono muted col-label">Sprints</p>
            {sprintPosts.length === 0 && <p class="empty muted mono">Nothing here yet.</p>}
            {sprintPosts.length > 0 && (
              <ol class="rows">
                {sprintPosts.map((p) => (
                  <li>
                    <a href={postUrl(p)} class="row">
                      <span class="mono muted">{kindLabel[p.data.kind]}</span>
                      <span class="row-title">{p.data.title}</span>
                      <Sparkline seed={p.id} width={120} height={28} class="row-spark" />
                      <span class="row-arrow" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    show.contact && (
      <section id="contact" class="contact" aria-labelledby="contact-h">
        <div class="wrap">
          <p class="kicker" data-reveal>
            {num('contact')} / Contact
          </p>
          <h2 id="contact-h" data-reveal>
            Say hello.
          </h2>
          <ul class="links">
            {visibleLinks.map((l, i) => (
              <li data-reveal style={`--d:${i}`}>
                <a class="link-row" href={l.href}>
                  <span>{l.label}</span>
                  <span class="link-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))}
            {resumeHref && (
              <li data-reveal>
                <a class="link-row" href={resumeHref}>
                  <span>Résumé (PDF)</span>
                  <span class="link-arrow" aria-hidden="true">
                    ↓
                  </span>
                </a>
              </li>
            )}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding-top: 5rem;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 70% at 18% 55%, color-mix(in srgb, var(--bg) 85%, transparent), transparent 70%),
      linear-gradient(to bottom, transparent 70%, var(--bg));
  }
  .hero-inner {
    position: relative;
    transform: translateY(calc(var(--hp, 0) * -80px));
    opacity: calc(1 - var(--hp, 0) * 1.2);
  }
  .hero-name {
    font-size: clamp(4.2rem, 15vw, 12.5rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    margin: 1.2rem 0 1.6rem;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
  }
  .hero-name span {
    font-style: italic;
    color: var(--accent);
    padding-left: 0.6em;
  }
  .hero-tag {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.3;
    max-width: 18em;
    margin: 0 0 1.4rem;
    color: var(--ink-2);
  }
  .hero-now {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-transform: none;
    color: var(--ink-2);
    margin: 0 0 2.2rem;
    padding: 0.2rem 0.4rem;
  }
  .now-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--up);
    box-shadow: 0 0 12px var(--up);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .hero-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.6rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .scroll-line {
    width: 60px;
    height: 1px;
    background: var(--muted);
    transform-origin: left;
    animation: scrollhint 2.2s var(--ease) infinite;
  }
  .hero-note {
    margin-left: auto;
  }
  @keyframes scrollhint {
    0% {
      transform: scaleX(0);
    }
    60% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }
  :global(.js) .hero-inner > * {
    animation: rise 1.1s var(--ease) both;
  }
  :global(.js) .hero-inner > :nth-child(2) {
    animation-delay: 0.08s;
  }
  :global(.js) .hero-inner > :nth-child(3) {
    animation-delay: 0.2s;
  }
  :global(.js) .hero-inner > :nth-child(4) {
    animation-delay: 0.3s;
  }
  :global(.js) .hero-inner > :nth-child(5) {
    animation-delay: 0.4s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40px);
      filter: blur(6px);
    }
  }

  section h2 {
    font-size: clamp(2.2rem, 5.5vw, 4.2rem);
  }
  .sec-head {
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }
  .sec-head h2 {
    margin-top: 1rem;
  }
  .about {
    padding: clamp(4rem, 9vw, 7rem) 0 clamp(2rem, 5vw, 3rem);
  }
  .about-inner {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1rem 3rem;
    align-items: baseline;
  }
  .about h2 {
    font-size: clamp(2.4rem, 6vw, 4.6rem);
  }
  .bio {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 42rem;
    margin: 1.2rem 0 0;
    padding: 0.2rem 0.4rem;
  }

  .latest {
    padding: clamp(3.5rem, 8vw, 6rem) 0 0;
  }
  .col-label {
    margin: 0 0 1rem;
  }
  .empty {
    margin: 0 0 3rem;
  }
  .rows {
    list-style: none;
    padding: 0;
    margin: 0 0 4rem;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr) 120px 1.5rem;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding: 1.15rem 0.4rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition:
      background 0.3s var(--ease),
      padding 0.4s var(--ease);
  }
  .row-title {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2vw, 1.7rem);
    line-height: 1.15;
  }
  :global(.row-spark) {
    justify-self: end;
    opacity: 0.35;
    transition: opacity 0.3s;
  }
  .row-arrow {
    font-size: 1.3rem;
    transition: transform 0.4s var(--ease);
  }
  .row:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    padding-left: 1.1rem;
  }
  .row:hover .row-arrow {
    transform: translateX(6px);
    color: var(--accent);
  }
  .row:hover :global(.row-spark) {
    opacity: 1;
  }

  .bands {
    display: block;
  }
  .enter {
    position: relative;
    display: block;
    overflow: hidden;
    padding: clamp(3.5rem, 9vw, 7rem) 0;
    background: var(--accent);
    color: var(--accent-ink);
    text-decoration: none;
  }
  .enter:hover {
    color: var(--accent-ink);
  }
  .enter .kicker {
    color: var(--accent-ink);
    opacity: 0.7;
  }
  .enter-marquee {
    position: absolute;
    inset: auto 0 0.6rem 0;
    display: flex;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.45;
  }
  .enter-marquee span {
    animation: tape 30s linear infinite;
    padding-right: 1rem;
  }
  @keyframes tape {
    to {
      transform: translateX(-100%);
    }
  }
  .enter-inner {
    position: relative;
    padding-inline: clamp(1.25rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .enter-title {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 5.5vw, 4.8rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-style: italic;
  }
  .enter-arrow {
    display: inline-block;
    font-style: normal;
    transition: transform 0.5s var(--ease);
  }
  .enter:hover .enter-arrow {
    transform: translateX(0.3em);
  }

  .contact {
    padding: clamp(4rem, 10vw, 7rem) 0;
  }
  .contact h2 {
    margin: 1rem 0 3rem;
    font-size: clamp(2.8rem, 8vw, 6rem);
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .link-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.3rem 0.5rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    text-decoration: none;
    transition: padding 0.4s var(--ease);
    outline-offset: -3px;
  }
  .link-arrow {
    margin-left: auto;
    transition: transform 0.4s var(--ease);
  }
  .link-row[href]:hover {
    padding-left: 1.2rem;
  }
  .link-row[href]:hover .link-arrow {
    transform: translate(4px, -4px);
  }

  .enter-alt {
    background: var(--surface);
    color: var(--ink);
    border-block: 1px solid var(--line);
  }
  .enter-alt:hover {
    color: var(--ink);
  }
  .enter-alt .kicker {
    color: var(--accent);
    opacity: 1;
  }
  .enter-alt .enter-marquee {
    color: var(--muted);
  }
  .enter-alt .enter-marquee span {
    animation-duration: 40s;
    animation-direction: reverse;
  }

  @media (max-width: 860px) {
    .about-inner {
      grid-template-columns: 1fr;
    }
    .row {
      grid-template-columns: 1fr 90px 1.5rem;
      grid-template-areas: 'meta meta meta' 'title spark arrow';
      gap: 0.35rem 0.8rem;
    }
    .row > :first-child {
      grid-area: meta;
    }
    .row-title {
      grid-area: title;
    }
    :global(.row-spark) {
      grid-area: spark;
    }
    .row-arrow {
      grid-area: arrow;
    }
    .hero-note {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .enter-marquee {
      display: none;
    }
    .hero-inner {
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          hero.style.setProperty('--hp', Math.min(1, Math.max(0, scrollY / hero.offsetHeight)).toFixed(3));
        });
      },
      { passive: true },
    );
  }
</script>
