---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import MarketField from '../components/MarketField.astro';
import Sparkline from '../components/Sparkline.astro';
import { site, isPlaceholder, visibleLinks } from '../site.config';
import { getPosts, fmtDate, postUrl } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 3);
const show = {
  about: !!site.about,
  work: site.projects.length > 0,
  writing: posts.length > 0,
  contact: visibleLinks.length > 0,
};
const firstSection = (['about', 'work', 'writing', 'contact'] as const).find((k) => show[k]);
---

<Base>
  <section class="hero" data-hero>
    <MarketField converge paths={36} />
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="kicker hero-kicker">{site.handle} · research desk</p>
      <h1 class="hero-name">{site.name.split(' ')[0]}<br /><span>{site.name.split(' ').slice(1).join(' ')}</span></h1>
      <p class="hero-tag">{site.tagline}</p>
      {
        site.currently && (
          <p class:list={['mono', 'hero-now', { ph: isPlaceholder(site.currently) }]}>
            <span class="now-dot" aria-hidden="true" />
            Currently: {site.currently}
          </p>
        )
      }
      <div class="hero-cta">
        {
          show.writing && (
            <a class="btn btn-primary" href={url('/blog/')}>
              Read the research log <span class="arrow" aria-hidden="true">→</span>
            </a>
          )
        }
        {
          firstSection && (
            <a class="btn" href={`#${firstSection}`}>
              Scroll <span class="arrow" aria-hidden="true">↓</span>
            </a>
          )
        }
      </div>
    </div>
    <div class="wrap hero-foot mono muted" aria-hidden="true">
      <span>scroll</span>
      <span class="scroll-line"></span>
      <span class="hero-note">signal ← noise · simulated tape</span>
    </div>
  </section>

  {
    show.about && (
      <section id="about" class="about" aria-labelledby="about-h">
        <div class="wrap about-inner">
          <p class="kicker" data-reveal>About</p>
          <div>
            <h2 id="about-h" data-reveal>
              Hi, I'm {site.name.split(' ')[0]}.
            </h2>
            <p class:list={['bio', { ph: isPlaceholder(site.about) }]} data-reveal style="--d:1">
              {site.about}
            </p>
          </div>
        </div>
      </section>
    )
  }

  {
    show.work && (
      <section id="work" class="work" aria-labelledby="work-h">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="kicker">Projects</p>
            <h2 id="work-h">On the bench.</h2>
          </header>
          <ul class="cards">
            {site.projects.map((p, i) => (
              <li data-reveal style={`--d:${i}`}>
                <div class="card" data-tilt>
                  <div class="card-top mono">
                    <span class="muted">P/{String(i + 1).padStart(2, '0')}</span>
                    {isPlaceholder(p.blurb) && <span class="ph-tag">placeholder</span>}
                  </div>
                  <h3>{p.title}</h3>
                  <p class="muted">{p.blurb}</p>
                  {p.stack.length > 0 && (
                    <ul class="chips">
                      {p.stack.map((s) => (
                        <li class="mono">{s}</li>
                      ))}
                    </ul>
                  )}
                  <Sparkline seed={p.title} width={300} height={56} class="card-spark" />
                  {p.href && (
                    <a class="card-link mono" href={p.href}>
                      View project <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    show.writing && (
      <section id="writing" class="writing" aria-labelledby="writing-h">
        <div class="wrap">
          <header class="sec-head" data-reveal>
            <p class="kicker">Latest from the research log</p>
            <h2 id="writing-h">Written down, including what breaks.</h2>
          </header>
          <ol class="latest">
            {latest.map((p, i) => (
              <li data-reveal style={`--d:${i}`}>
                <a href={postUrl(p)} class="row">
                  <span class="mono muted">{fmtDate(p.data.date)}</span>
                  <span class="row-title">{p.data.title}</span>
                  <Sparkline seed={p.id} width={120} height={28} class="row-spark" />
                  <span class="row-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <a class="enter" href={url('/blog/')} data-reveal>
          <span class="enter-marquee" aria-hidden="true">
            {[0, 1].map(() => (
              <span>{posts.map((p) => p.data.title).join('  ·  ')}  ·  </span>
            ))}
          </span>
          <span class="wrap enter-inner">
            <span class="kicker">
              {posts.length} {posts.length === 1 ? 'entry' : 'entries'}
            </span>
            <span class="enter-title">
              Enter the research log <span class="enter-arrow" aria-hidden="true">→</span>
            </span>
          </span>
        </a>
      </section>
    )
  }

  {
    show.contact && (
      <section id="contact" class="contact" aria-labelledby="contact-h">
        <div class="wrap">
          <p class="kicker" data-reveal>Contact</p>
          <h2 id="contact-h" data-reveal>
            Say hello.
          </h2>
          <ul class="links">
            {visibleLinks.map((l, i) => (
              <li data-reveal style={`--d:${i}`}>
                <a class="link-row" href={l.href}>
                  <span>{l.label}</span>
                  <span class="link-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding-top: 5rem;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 70% at 18% 55%, color-mix(in srgb, var(--bg) 85%, transparent), transparent 70%),
      linear-gradient(to bottom, transparent 70%, var(--bg));
  }
  .hero-inner {
    position: relative;
    transform: translateY(calc(var(--hp, 0) * -80px));
    opacity: calc(1 - var(--hp, 0) * 1.2);
  }
  .hero-name {
    font-size: clamp(4.2rem, 15vw, 12.5rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    margin: 1.2rem 0 1.6rem;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
  }
  .hero-name span {
    font-style: italic;
    color: var(--accent);
    padding-left: 0.6em;
  }
  .hero-tag {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.3;
    max-width: 30ch;
    margin: 0 0 1.4rem;
    color: var(--ink-2);
  }
  .hero-now {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-transform: none;
    color: var(--ink-2);
    margin: 0 0 2.2rem;
    padding: 0.2rem 0.4rem;
  }
  .now-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--up);
    box-shadow: 0 0 12px var(--up);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .hero-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.6rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .scroll-line {
    width: 60px;
    height: 1px;
    background: var(--muted);
    transform-origin: left;
    animation: scrollhint 2.2s var(--ease) infinite;
  }
  .hero-note {
    margin-left: auto;
  }
  @keyframes scrollhint {
    0% {
      transform: scaleX(0);
    }
    60% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }
  :global(.js) .hero-inner > * {
    animation: rise 1.1s var(--ease) both;
  }
  :global(.js) .hero-inner > :nth-child(2) {
    animation-delay: 0.08s;
  }
  :global(.js) .hero-inner > :nth-child(3) {
    animation-delay: 0.2s;
  }
  :global(.js) .hero-inner > :nth-child(4) {
    animation-delay: 0.3s;
  }
  :global(.js) .hero-inner > :nth-child(5) {
    animation-delay: 0.4s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40px);
      filter: blur(6px);
    }
  }

  section h2 {
    font-size: clamp(2.2rem, 5.5vw, 4.2rem);
  }
  .sec-head {
    max-width: 48rem;
    margin-bottom: 3rem;
  }
  .sec-head h2 {
    margin-top: 1rem;
  }

  .about {
    padding: clamp(3.5rem, 8vw, 6rem) 0;
  }
  .about-inner {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1rem 3rem;
    align-items: baseline;
  }
  .about h2 {
    font-size: clamp(2rem, 4.5vw, 3.4rem);
  }
  .bio {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 40rem;
    margin: 1.2rem 0 0;
    padding: 0.2rem 0.4rem;
  }

  .work {
    padding: clamp(3.5rem, 8vw, 6rem) 0;
    background: linear-gradient(to bottom, transparent, var(--bg-2) 30%, var(--bg-2) 70%, transparent);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
    perspective: 1200px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    height: 100%;
    transition:
      transform 0.5s var(--ease),
      border-color 0.3s;
  }
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(400px circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--accent) 12%, transparent), transparent 40%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
  }
  .card:hover::after {
    opacity: 1;
  }
  .card h3 {
    font-size: 1.55rem;
  }
  .card p {
    margin: 0;
    font-size: 0.95rem;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .chips li {
    font-size: 0.66rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-2);
  }
  :global(.card-spark) {
    margin-top: auto;
    padding-top: 1rem;
  }
  .card-link {
    text-decoration: none;
    color: var(--accent);
  }
  .card-link::before {
    content: '';
    position: absolute;
    inset: 0;
  }

  .writing {
    padding: clamp(3.5rem, 8vw, 6rem) 0 0;
  }
  .latest {
    list-style: none;
    padding: 0;
    margin: 0 0 4rem;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 9rem 1fr 120px 2rem;
    align-items: center;
    gap: 1.5rem;
    padding: 1.4rem 0.5rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition:
      background 0.3s var(--ease),
      padding 0.4s var(--ease);
  }
  .row-title {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.4vw, 1.9rem);
    line-height: 1.15;
  }
  .row-arrow {
    font-size: 1.4rem;
    transition: transform 0.4s var(--ease);
  }
  .row:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    padding-left: 1.25rem;
  }
  .row:hover .row-arrow {
    transform: translateX(6px);
    color: var(--accent);
  }
  :global(.row-spark) {
    opacity: 0.35;
    transition: opacity 0.3s;
  }
  .row:hover :global(.row-spark) {
    opacity: 1;
  }

  .enter {
    position: relative;
    display: block;
    overflow: hidden;
    padding: clamp(3.5rem, 9vw, 7rem) 0;
    background: var(--accent);
    color: var(--accent-ink);
    text-decoration: none;
  }
  .enter:hover {
    color: var(--accent-ink);
  }
  .enter .kicker {
    color: var(--accent-ink);
    opacity: 0.7;
  }
  .enter-marquee {
    position: absolute;
    inset: auto 0 0.6rem 0;
    display: flex;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.45;
  }
  .enter-marquee span {
    animation: tape 30s linear infinite;
    padding-right: 1rem;
  }
  @keyframes tape {
    to {
      transform: translateX(-100%);
    }
  }
  .enter-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .enter-title {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 8vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-style: italic;
  }
  .enter-arrow {
    display: inline-block;
    font-style: normal;
    transition: transform 0.5s var(--ease);
  }
  .enter:hover .enter-arrow {
    transform: translateX(0.3em);
  }

  .contact {
    padding: clamp(4rem, 10vw, 7rem) 0;
  }
  .contact h2 {
    margin: 1rem 0 3rem;
    font-size: clamp(2.8rem, 8vw, 6rem);
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .link-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.3rem 0.5rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    text-decoration: none;
    transition: padding 0.4s var(--ease);
    outline-offset: -3px;
  }
  .link-arrow {
    margin-left: auto;
    transition: transform 0.4s var(--ease);
  }
  .link-row[href]:hover {
    padding-left: 1.2rem;
  }
  .link-row[href]:hover .link-arrow {
    transform: translate(4px, -4px);
  }

  @media (max-width: 860px) {
    .about-inner {
      grid-template-columns: 1fr;
    }
    .row {
      grid-template-columns: 1fr auto;
      gap: 0.4rem 1rem;
    }
    .row > :first-child {
      grid-column: 1 / -1;
    }
    :global(.row-spark) {
      display: none;
    }
    .hero-note {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .enter-marquee {
      display: none;
    }
    .hero-inner {
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  if (!reduce) {
    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const p = Math.min(1, Math.max(0, scrollY / hero.offsetHeight));
          hero.style.setProperty('--hp', p.toFixed(3));
        });
      },
      { passive: true },
    );
  }


  if (!reduce && matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height;
        card.style.setProperty('--ry', `${(x - 0.5) * 8}deg`);
        card.style.setProperty('--rx', `${(0.5 - y) * 8}deg`);
        card.style.setProperty('--mx', `${x * 100}%`);
        card.style.setProperty('--my', `${y * 100}%`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }
</script>
