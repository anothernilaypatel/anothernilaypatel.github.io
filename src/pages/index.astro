---
// The home page is the `sections` list from src/site.config.ts (validated in src/lib/config.ts),
// rendered in order. To change it, edit that list or add a section type in src/sections/.
import Base from '../layouts/Base.astro';
import { sections } from '../lib/config';
import { componentFor, isVisible } from '../lib/sections';

const visible = sections.filter(isVisible);
---

<Base>
  {
    visible.map(({ type, nav, hidden, ...props }) => {
      const Section = componentFor({ type, ...props });
      return <Section {...props} />;
    })
  }
</Base>
