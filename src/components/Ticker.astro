---
interface Props {
  items: { label: string; value: string; dir?: 'up' | 'down' }[];
}
const { items } = Astro.props;
---

<div class="ticker" role="region" aria-label="At a glance">
  <ul class="track">
    {
      items.map((it) => (
        <li>
          <span class="muted">{it.label}</span>
          <span class:list={['val', it.dir]}>
            {it.dir === 'up' ? '▲ ' : it.dir === 'down' ? '▼ ' : ''}
            {it.value}
          </span>
        </li>
      ))
    }
  </ul>
  <ul class="track" aria-hidden="true">
    {
      items.map((it) => (
        <li>
          <span class="muted">{it.label}</span>
          <span class:list={['val', it.dir]}>
            {it.dir === 'up' ? '▲ ' : it.dir === 'down' ? '▼ ' : ''}
            {it.value}
          </span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .ticker {
    display: flex;
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: var(--bg-2);
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .track {
    display: flex;
    flex-shrink: 0;
    gap: 3rem;
    margin: 0;
    padding: 0.85rem 1.5rem;
    list-style: none;
    animation: tape 38s linear infinite;
  }
  .ticker:hover .track {
    animation-play-state: paused;
  }
  li {
    display: flex;
    gap: 0.7rem;
    white-space: nowrap;
  }
  .val {
    color: var(--ink);
  }
  .up {
    color: var(--up);
  }
  .down {
    color: var(--down);
  }
  @keyframes tape {
    to {
      transform: translateX(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker {
      flex-wrap: wrap;
    }
    .track {
      animation: none;
      flex-wrap: wrap;
      gap: 0.5rem 2rem;
    }
    .track[aria-hidden] {
      display: none;
    }
  }
</style>
