---
import { walk, movingAverage, rng, gaussian } from '../lib/series';

export interface Chapter {
  num: string;
  date: string;
  title: string;
  body: string;
  fig: string;
  href?: string;
}
interface Props {
  chapters: Chapter[];
}
const { chapters } = Astro.props;

const W = 600;
const TOTAL = 300;
const base = walk(42, 220, { drift: 0.0011, vol: 0.016 });
const crash: number[] = [base[base.length - 1]];
const r = rng(9);
for (let i = 1; i < 40; i++) crash.push(crash[i - 1] * Math.exp(-0.009 + 0.012 * gaussian(r)));
const fans = Array.from({ length: 9 }, (_, k) => {
  const rr = rng(100 + k);
  const out = [crash[crash.length - 1]];
  for (let i = 1; i < 40; i++) out.push(out[i - 1] * Math.exp(0.002 + 0.02 * gaussian(rr)));
  return out;
});
const ma = movingAverage(base, 30);

const all = [...base, ...crash, ...fans.flat()];
const lo = Math.min(...all);
const hi = Math.max(...all);
const X = (i: number) => (i / (TOTAL - 1)) * W;
const Y = (v: number) => 24 + (1 - (v - lo) / (hi - lo)) * 236;
const path = (xs: number[], start = 0) =>
  xs.map((v, i) => `${i ? 'L' : 'M'}${X(start + i).toFixed(1)} ${Y(v).toFixed(1)}`).join('');

const pricePath = path(base);
const maPath = path(ma);
const crashPath = path(crash, 219);
const fanPaths = fans.map((f) => path(f, 258));

const deriv = ma.map((v, i) => (i < 5 ? 0 : v - ma[i - 5]));
const dmax = Math.max(...deriv.map(Math.abs)) || 1;
const bars = deriv
  .map((d, i) => ({ x: X(i), h: (d / dmax) * 34, up: d >= 0 }))
  .filter((_, i) => i % 2 === 0);
---

<section id="story" class="story" aria-labelledby="story-h">
  <div class="wrap">
    <header class="story-head" data-reveal>
      <p class="kicker">The story so far</p>
      <h2 id="story-h">From an empty notebook<br /> to a <em>(broken)</em> trading stack.</h2>
    </header>

    <div class="story-grid" data-story data-step="1">
      <div class="chart-col">
        <figure class="chart" aria-hidden="true">
          <div class="chart-top mono">
            <span class="fig-label" data-fig>{chapters[0].fig}</span>
            <span class="readout" data-readout>t = 0.00</span>
          </div>
          <svg viewBox={`0 0 ${W} 380`} preserveAspectRatio="none">
            <g class="grid">
              {[0, 1, 2, 3, 4].map((i) => <line x1="0" x2={W} y1={24 + i * 59} y2={24 + i * 59} />)}
              <line x1="0" x2={W} y1="325" y2="325" class="zero" />
            </g>
            <path class="l-price" d={pricePath} pathLength="1" />
            <path class="l-ma" d={maPath} pathLength="1" />
            <g class="l-deriv">
              {bars.map((b) => <rect x={b.x} y={b.up ? 325 - b.h : 325} width="2" height={Math.abs(b.h) || 0.5} class={b.up ? 'b-up' : 'b-down'} />)}
            </g>
            <path class="l-crash" d={crashPath} pathLength="1" />
            <g class="l-crash-tag">
              <rect x={X(236)} y={Y(crash[20]) - 54} width="150" height="26" rx="3" />
              <text x={X(236) + 10} y={Y(crash[20]) - 36}>AttributeError: yf</text>
            </g>
            <g class="l-fan">{fanPaths.map((d) => <path d={d} pathLength="1" />)}</g>
            <line class="cursor" data-cursor x1="0" x2="0" y1="10" y2="370" />
          </svg>
          <div class="legend mono">
            <span class="lg lg-price">EUR/USD (simulated)</span>
            <span class="lg lg-ma">30d MA</span>
            <span class="lg lg-deriv">Momentum</span>
            <span class="lg lg-fan">Next</span>
          </div>
        </figure>
      </div>

      <ol class="chapters">
        {
          chapters.map((c, i) => (
            <li class="chapter" data-chapter={i + 1} data-fig-text={c.fig}>
              <p class="mono ch-meta">
                <span class="ch-num">{c.num}</span>
                <span class="muted">{c.date}</span>
              </p>
              <h3>{c.title}</h3>
              <p class="ch-body">{c.body}</p>
              {c.href && (
                <a class="ch-link mono" href={c.href}>
                  Read the entry <span aria-hidden="true">→</span>
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .story {
    padding: clamp(5rem, 12vw, 9rem) 0 4rem;
  }
  .story-head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 6vw, 4rem);
  }
  .story-head h2 {
    font-size: clamp(2.2rem, 5.5vw, 4.2rem);
    margin-top: 1rem;
  }
  em {
    font-style: italic;
    color: var(--muted);
  }
  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
  }
  .chart-col {
    position: relative;
  }
  .chart {
    position: sticky;
    top: 18vh;
    margin: 0;
    padding: 1.1rem 1.1rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    backdrop-filter: blur(4px);
  }
  .chart-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-2);
    margin-bottom: 0.6rem;
    min-height: 1.2em;
  }
  .readout {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  svg {
    width: 100%;
    height: clamp(220px, 42vh, 380px);
    overflow: visible;
  }
  .grid line {
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .grid .zero {
    stroke-dasharray: 3 4;
  }
  path {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-dasharray: 1;
  }
  .l-price {
    stroke: var(--ink);
    stroke-width: 1.6;
  }
  .l-ma {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .l-crash {
    stroke: var(--down);
    stroke-width: 2;
  }
  .l-fan path {
    stroke: var(--up);
    stroke-width: 1.1;
    stroke-opacity: 0.55;
  }
  .b-up {
    fill: var(--up);
  }
  .b-down {
    fill: var(--down);
  }
  .l-crash-tag rect {
    fill: color-mix(in srgb, var(--down) 15%, var(--surface));
    stroke: var(--down);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .l-crash-tag text {
    fill: var(--down);
    font-family: var(--mono);
    font-size: 12px;
  }
  .cursor {
    stroke: var(--accent);
    stroke-opacity: 0.5;
    stroke-dasharray: 2 4;
    vector-effect: non-scaling-stroke;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.68rem;
  }
  .lg::before {
    content: '';
    display: inline-block;
    width: 14px;
    height: 2px;
    margin-right: 0.45rem;
    vertical-align: middle;
    background: currentColor;
  }
  .lg-price::before {
    background: var(--ink);
  }
  .lg-ma::before {
    background: var(--accent);
  }
  .lg-deriv::before {
    background: linear-gradient(90deg, var(--up) 50%, var(--down) 50%);
  }
  .lg-fan::before {
    background: var(--up);
  }

  /* Layer choreography, driven by data-step on the grid. Without JS everything is visible. */
  :global(.js) .story-grid path {
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.8s var(--ease);
  }
  :global(.js) .story-grid .l-deriv,
  :global(.js) .story-grid .l-crash-tag,
  :global(.js) .story-grid .lg-ma,
  :global(.js) .story-grid .lg-deriv,
  :global(.js) .story-grid .lg-fan {
    opacity: 0;
    transition: opacity 0.8s var(--ease);
  }
  :global(.js) .story-grid .l-deriv {
    transform: scaleY(0);
    transform-origin: 0 325px;
    transition:
      transform 1.2s var(--ease),
      opacity 0.8s var(--ease);
  }
  :global(.js) [data-step] .l-price {
    stroke-dashoffset: 0;
  }
  :global(.js) :is([data-step='2'], [data-step='3'], [data-step='4'], [data-step='5']) :is(.l-ma) {
    stroke-dashoffset: 0;
  }
  :global(.js) :is([data-step='2'], [data-step='3'], [data-step='4'], [data-step='5']) .lg-ma {
    opacity: 1;
  }
  :global(.js) :is([data-step='3'], [data-step='4'], [data-step='5']) :is(.l-deriv, .lg-deriv) {
    opacity: 1;
    transform: none;
  }
  :global(.js) :is([data-step='4'], [data-step='5']) .l-crash {
    stroke-dashoffset: 0;
  }
  :global(.js) [data-step='4'] .l-crash-tag {
    opacity: 1;
    animation: glitch 0.5s steps(2) 2;
  }
  :global(.js) [data-step='4'] .l-price,
  :global(.js) [data-step='4'] .l-ma {
    stroke-opacity: 0.45;
  }
  :global(.js) [data-step='5'] :is(.l-fan path) {
    stroke-dashoffset: 0;
  }
  :global(.js) [data-step='5'] .lg-fan {
    opacity: 1;
  }
  @keyframes glitch {
    50% {
      transform: translate(3px, -2px);
    }
  }

  .chapters {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chapter {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 0;
    opacity: 0.28;
    transition: opacity 0.6s var(--ease);
  }
  .chapter.active,
  :global(html:not(.js)) .chapter {
    opacity: 1;
  }
  .chapter:last-child {
    min-height: 60vh;
  }
  .ch-meta {
    display: flex;
    gap: 1rem;
    margin: 0 0 0.9rem;
  }
  .ch-num {
    color: var(--accent);
  }
  .chapter h3 {
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    margin-bottom: 1rem;
  }
  .ch-body {
    color: var(--ink-2);
    max-width: 34rem;
    margin: 0 0 1.2rem;
  }
  .ch-link {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    align-self: flex-start;
    padding-bottom: 2px;
  }

  @media (max-width: 860px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .chart-col {
      position: sticky;
      top: 4.6rem;
      z-index: 2;
    }
    .chart {
      position: relative;
      top: 0;
      padding: 0.75rem;
      background: var(--surface);
      backdrop-filter: none;
      box-shadow: 0 18px 30px -18px rgb(0 0 0 / 0.35);
    }
    svg {
      height: 26vh;
    }
    .chapter {
      min-height: 62vh;
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>('[data-story]');
  if (grid) {
    const chapters = [...grid.querySelectorAll<HTMLElement>('[data-chapter]')];
    const fig = grid.querySelector<HTMLElement>('[data-fig]')!;
    const readout = grid.querySelector<HTMLElement>('[data-readout]')!;
    const cursor = grid.querySelector<SVGLineElement>('[data-cursor]')!;

    const setStep = (el: HTMLElement) => {
      chapters.forEach((c) => c.classList.toggle('active', c === el));
      grid.dataset.step = el.dataset.chapter;
      fig.textContent = el.dataset.figText ?? '';
    };
    setStep(chapters[0]);

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) setStep(e.target as HTMLElement);
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    chapters.forEach((c) => io.observe(c));

    let ticking = false;
    const update = () => {
      ticking = false;
      const r = grid.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.5 - r.top) / r.height));
      const x = (p * 600).toFixed(1);
      cursor.setAttribute('x1', x);
      cursor.setAttribute('x2', x);
      readout.textContent = `t = ${p.toFixed(2)}`;
    };
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
