---
import Sparkline from '../Sparkline.astro';
import { isPlaceholder } from '../../site.config';

interface Props {
  items: { name: string; blurb: string; badge?: string; href?: string }[];
  n: string;
}
const { items, n } = Astro.props;
---

<section id="interests" class="int" aria-labelledby="int-h" data-hs>
  <div class="int-sticky">
    <div class="wrap int-head">
      <div data-reveal>
        <p class="kicker">{n} / Interests</p>
        <h2 id="int-h">Off the clock.</h2>
      </div>
      <p class="mono muted int-hint" aria-hidden="true">scroll <span>→</span></p>
    </div>
    <div class="int-viewport" data-hs-viewport>
      <ul class="int-track" data-hs-track>
        {
          items.map((it, i) => (
            <li class="int-card" data-tilt>
              <div class="int-top mono">
                <span class="muted">{String(i + 1).padStart(2, '0')}</span>
                {it.badge && <span class="badge">{it.badge}</span>}
              </div>
              <h3>{it.name}</h3>
              <p class:list={['int-blurb', { ph: isPlaceholder(it.blurb) }]}>{it.blurb}</p>
              <Sparkline seed={it.name} width={300} height={54} class="int-spark draw" />
              {it.href && (
                <a class="int-link mono" href={it.href}>
                  Read the post <span aria-hidden="true">→</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="wrap int-progress" aria-hidden="true"><span data-hs-bar></span></div>
  </div>
</section>

<style>
  .int {
    position: relative;
    padding: clamp(3.5rem, 8vw, 6rem) 0;
  }
  .int-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 2.2rem;
  }
  .int-head h2 {
    font-size: clamp(2.2rem, 5.5vw, 4.2rem);
    margin-top: 1rem;
  }
  .int-hint span {
    display: inline-block;
    animation: nudge 1.8s var(--ease) infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateX(6px);
    }
  }
  .int-viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .int-viewport::-webkit-scrollbar {
    display: none;
  }
  .int-track {
    --pad: calc((100vw - min(1180px, 100vw - 2.5rem)) / 2);
    display: flex;
    gap: 1.25rem;
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--pad) 1rem;
    perspective: 1200px;
    will-change: transform;
  }
  .int-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: min(78vw, 340px);
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
    scroll-snap-align: center;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.5s var(--ease),
      border-color 0.3s;
  }
  .int-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(380px circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--accent) 12%, transparent), transparent 40%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .int-card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
  }
  .int-card:hover::after {
    opacity: 1;
  }
  .int-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .badge {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.68rem;
  }
  .int-card h3 {
    font-size: 1.9rem;
  }
  .int-blurb {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.98rem;
    padding: 0.1rem 0.3rem;
    margin-left: -0.3rem;
  }
  :global(.int-spark) {
    margin-top: auto;
    padding-top: 0.8rem;
  }
  .int-link {
    color: var(--accent);
    text-decoration: none;
  }
  .int-link::before {
    content: '';
    position: absolute;
    inset: 0;
  }
  .int-progress {
    height: 2px;
    margin-top: 1.5rem;
    background: var(--line);
    display: none;
  }
  .int-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }

  /* Pinned mode (wide screens, motion allowed, cards overflow): vertical scroll drives the strip. */
  .int.hs-on {
    padding: 0;
  }
  .int.hs-on .int-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .int.hs-on .int-viewport {
    overflow: visible;
    scroll-snap-type: none;
  }
  .int.hs-on .int-track {
    transform: translate3d(var(--x, 0px), 0, 0);
  }
  .int.hs-on .int-progress {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .int-hint span {
      animation: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-hs]');
  const track = section?.querySelector<HTMLElement>('[data-hs-track]');
  const viewport = section?.querySelector<HTMLElement>('[data-hs-viewport]');
  const bar = section?.querySelector<HTMLElement>('[data-hs-bar]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  if (section && track && viewport && bar) {
    let overflow = 0;
    let on = false;

    const progress = () => {
      const r = section.getBoundingClientRect();
      const span = r.height - innerHeight;
      return span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : 0;
    };
    const paint = () => {
      if (!on) return;
      const p = progress();
      track.style.setProperty('--x', `${(-p * overflow).toFixed(1)}px`);
      bar.style.setProperty('--p', p.toFixed(3));
    };
    const layout = () => {
      section.classList.remove('hs-on');
      section.style.height = '';
      overflow = track.offsetWidth - viewport.clientWidth;
      on = !reduce.matches && innerWidth >= 900 && overflow > 40;
      if (on) {
        section.classList.add('hs-on');
        section.style.height = `${innerHeight + overflow}px`;
      }
      paint();
    };

    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            paint();
          });
        }
      },
      { passive: true },
    );
    addEventListener('resize', layout);
    reduce.addEventListener('change', layout);
    document.fonts?.ready.then(layout);
    layout();

    // Keep keyboard focus visible: scroll the page so the focused card is on screen.
    track.addEventListener('focusin', (e) => {
      if (!on) return;
      const card = (e.target as HTMLElement).closest<HTMLElement>('.int-card');
      if (!card) return;
      const p = Math.min(1, Math.max(0, (card.offsetLeft - viewport.clientWidth / 2 + card.offsetWidth / 2) / overflow));
      const top = section.getBoundingClientRect().top + scrollY;
      scrollTo({ top: top + p * (section.offsetHeight - innerHeight), behavior: 'instant' as ScrollBehavior });
    });
  }

  if (!reduce.matches && matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLElement>('.int-card[data-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height;
        card.style.setProperty('--ry', `${(x - 0.5) * 8}deg`);
        card.style.setProperty('--rx', `${(0.5 - y) * 8}deg`);
        card.style.setProperty('--mx', `${x * 100}%`);
        card.style.setProperty('--my', `${y * 100}%`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }
</script>
