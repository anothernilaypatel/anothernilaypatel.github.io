---
import { isPlaceholder } from '../../site.config';

interface Props {
  groups: { group: string; items: string[] }[];
  n: string;
}
const { groups, n } = Astro.props;
---

<section id="skills" class="skills" aria-labelledby="skills-h">
  <div class="wrap">
    <header class="head" data-reveal>
      <p class="kicker">{n} / Skills</p>
      <h2 id="skills-h">The toolkit.</h2>
    </header>
    <dl class="groups">
      {
        groups.map((g, gi) => (
          <div class="group" data-reveal style={`--d:${gi}`}>
            <dt class="mono">{g.group}</dt>
            <dd>
              <ul>
                {g.items.map((s, i) => (
                  <li class:list={['chip', { ph: isPlaceholder(s) }]} style={`--i:${i}`}>
                    {s}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .skills {
    padding: clamp(3.5rem, 8vw, 6rem) 0;
    background: linear-gradient(to bottom, transparent, var(--bg-2) 30%, var(--bg-2) 70%, transparent);
  }
  .head {
    margin-bottom: 2.5rem;
  }
  .head h2 {
    font-size: clamp(2.2rem, 5.5vw, 4.2rem);
    margin-top: 1rem;
  }
  .groups {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .group {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1rem 2rem;
    align-items: baseline;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chip {
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--ink);
    background: var(--surface);
    transition:
      transform 0.35s var(--ease),
      border-color 0.35s,
      color 0.35s;
  }
  .chip:hover {
    transform: translateY(-3px) rotate(-1.5deg);
    border-color: var(--accent);
    color: var(--accent);
  }
  :global(.js) .group .chip {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease),
      border-color 0.35s,
      color 0.35s;
    transition-delay: calc(var(--i) * 50ms + 150ms), calc(var(--i) * 50ms + 150ms), 0s, 0s;
  }
  :global(.js) .group.is-in .chip {
    opacity: 1;
    transform: none;
  }
  :global(.js) .group.is-in .chip:hover {
    transform: translateY(-3px) rotate(-1.5deg);
    transition-delay: 0s;
  }
  @media (max-width: 720px) {
    .group {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .group .chip {
      opacity: 1;
      transform: none;
    }
  }
</style>
