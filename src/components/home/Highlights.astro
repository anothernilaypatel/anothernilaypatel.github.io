---
import { isPlaceholder } from '../../site.config';
import { href } from '../../lib/url';

interface Item {
  value: string;
  label?: string;
  /** Project name, when the big line is a place (2nd, :)) and the event is the label. */
  project?: string;
  detail?: string;
  href?: string;
  /** Span the whole highlight row. The value is a title, not a countdown. */
  wide?: boolean;
  /** Count the number up from zero (amounts) instead of down into place (ranks). */
  countUp?: boolean;
  /** A numbered pipeline drawn under the detail, e.g. how a piece of work gets done. */
  steps?: string[];
  /** Anchor id, so other sections can link to the card. */
  id?: string;
}
interface Props {
  groups: { label: string; items: Item[] }[];
  n: string;
}
const { groups, n } = Astro.props;
---

<section id="highlights" class="hl" aria-labelledby="hl-h">
  <div class="wrap">
    <p class="kicker" data-reveal>{n} / Highlights</p>
    <h2 id="hl-h" class="sr-only">Highlights</h2>
    {
      groups.map((group) => (
        <div class="hl-group">
          {group.label && (
            <h3 class="hl-cat kicker" data-reveal>
              {group.label}
            </h3>
          )}
          <ul class="hl-list">
            {group.items.map((h, i) => {
              const Tag = h.href ? 'a' : 'div';
              const longest = Math.max(...h.value.split(/\s+/).map((word) => word.length));
              const scale = h.wide ? '' : longest > 8 ? 'compact' : longest > 4 ? 'medium' : '';
              return (
                <li class:list={{ wide: h.wide }} id={h.id} data-reveal style={`--d:${i}`}>
                  <Tag class:list={['hl-card', { wide: h.wide }]} href={h.href ? href(h.href) : undefined} data-hl-card>
                    <span
                      class:list={['hl-value', scale]}
                      data-countdown={h.wide || h.countUp ? undefined : h.value}
                      data-countup={h.countUp ? h.value : undefined}
                    >
                      {h.value}
                    </span>
                    {h.label && <span class="hl-label">{h.label}</span>}
                    {h.project && <span class="hl-label">{h.project}</span>}
                    {h.detail && <span class:list={['hl-detail', { ph: isPlaceholder(h.detail) }]}>{h.detail}</span>}
                    {h.steps && h.steps.length > 0 && (
                      <ol class="hl-steps" data-steps>
                        {h.steps.map((step, k) => (
                          <li style={`--k:${k}`}>
                            <span class="step-n mono">{String(k + 1).padStart(2, '0')}</span>
                            <span class="step-label">{step}</span>
                          </li>
                        ))}
                      </ol>
                    )}
                    <span class="hl-glow" aria-hidden="true" />
                    {h.href && (
                      <span class="hl-hint mono" aria-hidden="true" data-hl-hint>
                        <span class="hint-pointer">Click to read</span>
                        <span class="hint-touch">Tap to read</span> →
                      </span>
                    )}
                  </Tag>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .hl {
    padding: clamp(3rem, 7vw, 5rem) 0;
  }
  .hl-group + .hl-group {
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
  }
  .hl-cat {
    margin: 1.6rem 0 0;
    font-size: 0.85rem;
  }
  .hl-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
  }
  .hl-list > li[id] {
    scroll-margin-top: 6rem;
  }
  .hl-list > li.wide {
    grid-column: 1 / -1;
  }
  .hl-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: clamp(1.6rem, 4vw, 2.6rem);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--line));
    border-radius: 20px;
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 55%),
      var(--surface);
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
  }
  .hl-card:hover {
    color: var(--ink);
  }
  .hl-value {
    font-family: var(--serif);
    font-size: clamp(4rem, 12vw, 8.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
  }
  .hl-value.medium {
    font-size: clamp(3.2rem, 8vw, 4.75rem);
    line-height: 0.95;
  }
  .hl-value.compact {
    font-size: clamp(1.85rem, 4.6vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .hl-card.wide .hl-value {
    font-size: clamp(1.9rem, 3.5vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 22em;
  }
  .hl-card.wide .hl-detail {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    max-width: 40rem;
  }
  .hl-label {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    line-height: 1.1;
  }
  .hl-detail {
    color: var(--ink-2);
    max-width: 34rem;
    padding: 0.15rem 0.35rem;
    margin-left: -0.35rem;
  }
  .hl-steps {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
  }
  /* The rail fills with scroll (--p, 0 to 1, set by the script), and each dot lights as the fill reaches it. */
  .hl-steps::before,
  .hl-steps::after {
    content: '';
    position: absolute;
    left: 0.55rem;
    right: 0.55rem;
    top: 0.55rem;
    height: 2px;
    background: var(--line);
  }
  .hl-steps::after {
    background: var(--accent);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }
  /* Once the script has measured the dots, the rail runs exactly from the first dot to the last. */
  .hl-steps[data-rail]::before,
  .hl-steps[data-rail]::after {
    right: auto;
    width: var(--rail);
  }
  .hl-steps li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1.7rem;
  }
  .hl-steps li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    border: 2px solid var(--line);
    background: var(--surface);
    transition:
      border-color 0.25s,
      background 0.25s,
      transform 0.25s var(--ease);
  }
  .hl-steps li.on::before {
    border-color: var(--accent);
    background: var(--accent);
    transform: scale(1.15);
  }
  .step-n {
    font-size: 0.75rem;
    color: var(--muted);
    transition: color 0.25s;
  }
  .step-label {
    font-family: var(--serif);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.2;
    color: var(--muted);
    transition: color 0.25s;
  }
  .hl-steps li.on .step-n {
    color: var(--accent);
  }
  .hl-steps li.on .step-label {
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .hl-steps {
      grid-auto-flow: row;
      gap: 0.9rem;
    }
    .hl-steps::before,
    .hl-steps::after {
      left: 0.55rem;
      right: auto;
      top: 0.55rem;
      bottom: 2.3rem;
      width: 2px;
      height: auto;
    }
    .hl-steps::after {
      transform: scaleY(var(--p, 0));
      transform-origin: top;
    }
    .hl-steps[data-rail]::before,
    .hl-steps[data-rail]::after {
      bottom: auto;
      width: 2px;
      height: var(--rail);
    }
    .hl-steps li {
      padding: 0 0 0 2rem;
    }
  }
  .hl-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(420px circle at var(--mx, 80%) var(--my, 20%), color-mix(in srgb, var(--accent) 14%, transparent), transparent 45%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .hl-card:hover .hl-glow {
    opacity: 1;
  }
  .hl-hint {
    position: absolute;
    left: var(--hx, auto);
    top: var(--hy, auto);
    right: auto;
    bottom: auto;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.75rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 0.2s,
      transform 0.2s var(--ease);
  }
  .hint-touch {
    display: none;
  }
  .hl-card:hover .hl-hint {
    opacity: 1;
    transform: scale(1);
  }
  /* Keyboard focus and touch screens have no cursor to follow, so the hint sits in the corner. */
  .hl-card:focus-visible .hl-hint {
    left: auto;
    top: auto;
    right: 1.2rem;
    bottom: 1.2rem;
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .hl-hint {
      left: auto;
      top: auto;
      right: 1.2rem;
      bottom: 1.2rem;
      opacity: 0.85;
      transform: none;
    }
    .hint-pointer {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }
  /* Set once a real mouse moves over the card, for devices that report (hover: none) but have one. */
  .hl-card[data-mouse] .hl-hint {
    left: var(--hx, auto);
    top: var(--hy, auto);
    right: auto;
    bottom: auto;
    opacity: 0;
    transform: scale(0.9);
  }
  .hl-card[data-mouse]:hover .hl-hint {
    opacity: 1;
    transform: scale(1);
  }
  .hl-card[data-mouse] .hint-pointer {
    display: inline;
  }
  .hl-card[data-mouse] .hint-touch {
    display: none;
  }
  .hl-card[data-mouse]:focus-visible:not(:hover) .hl-hint {
    left: auto;
    top: auto;
    right: 1.2rem;
    bottom: 1.2rem;
    opacity: 1;
    transform: none;
  }
  @media (max-width: 860px) {
    .hl-list {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-hl-card]').forEach((card) => {
    const hint = card.querySelector<HTMLElement>('[data-hl-hint]');
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      card.style.setProperty('--mx', `${x}px`);
      card.style.setProperty('--my', `${y}px`);
      if (hint) {
        if (e.pointerType === 'mouse') card.dataset.mouse = '';
        // The card clips its overflow, so keep the pill inside it near the edges.
        const hx = Math.min(x + 16, r.width - hint.offsetWidth - 8);
        const hy = Math.min(y + 16, r.height - hint.offsetHeight - 8);
        card.style.setProperty('--hx', `${Math.max(8, hx)}px`);
        card.style.setProperty('--hy', `${Math.max(8, hy)}px`);
      }
    });
  });

  // Every highlight number counts down into place, the way "Top 1%" does:
  // "2nd" keeps a real ordinal, and a percent keeps its % sign.
  const ordinal = (n: number) => {
    const teen = n % 100;
    if (teen >= 11 && teen <= 13) return 'th';
    return ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th';
  };
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      io.unobserve(e.target);
      const el = e.target as HTMLElement;
      const text = el.dataset.countdown ?? '';
      // ":)" tries on a bunch of faces, then settles into the smile.
      if (text === ':)') {
        if (reduce) continue;
        const faces = [':(', ':|', ':O', ':P', ';)', ':S', ':/', 'B)', '8)', ':3', 'xD', ':*', ':D'];
        const t0 = performance.now();
        const tick = (now: number) => {
          const k = Math.min(1, (now - t0) / 1600);
          if (k >= 0.72) {
            el.textContent = ':)';
            return;
          }
          const eased = 1 - Math.pow(1 - k / 0.72, 2);
          el.textContent = faces[Math.min(faces.length - 1, Math.floor(eased * faces.length))];
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        continue;
      }
      const m = text.match(/^(.*?)(\d[\d,]*)(%|st|nd|rd|th)?(.*)$/i);
      if (!m || reduce) continue;
      const [, prefix, digits, suffix = '', rest] = m;
      const target = Number(digits.replace(/,/g, ''));
      if (!Number.isFinite(target)) continue;
      const ordinalSuffix = /^(st|nd|rd|th)$/i.test(suffix);
      const from = target >= 10 ? Math.max(target * 40, 1000) : Math.max(target * 24, 12);
      const paint = (n: number) => {
        const end = suffix === '%' ? '%' : ordinalSuffix ? ordinal(n) : suffix;
        el.textContent = `${prefix}${n.toLocaleString('en-US')}${end}${rest}`;
      };
      const t0 = performance.now();
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / 1600);
        const eased = 1 - Math.pow(1 - k, 4);
        paint(Math.round(from + (target - from) * eased));
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  });
  document.querySelectorAll('[data-countdown]').forEach((el) => io.observe(el));

  // Amounts count up from zero, keeping their decimals: "$1.4M" runs $0.0M, $0.7M, … $1.4M.
  const up = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      up.unobserve(e.target);
      const el = e.target as HTMLElement;
      const m = (el.dataset.countup ?? '').match(/^(.*?)(\d[\d,]*(?:\.\d+)?)(.*)$/);
      if (!m || reduce) continue;
      const [, prefix, digits, rest] = m;
      const target = Number(digits.replace(/,/g, ''));
      const decimals = digits.split('.')[1]?.length ?? 0;
      const t0 = performance.now();
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / 1600);
        const eased = 1 - Math.pow(1 - k, 4);
        const n = target * eased;
        el.textContent = `${prefix}${n.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals })}${rest}`;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  });
  document.querySelectorAll('[data-countup]').forEach((el) => up.observe(el));

  // The pipeline rail tracks scroll: empty while the card's middle is low in the viewport,
  // full once it's a little above center. A dot lights when the fill reaches it.
  const pipelines = [...document.querySelectorAll<HTMLElement>('[data-steps]')];
  let queued = false;
  const paintSteps = () => {
    queued = false;
    const vh = innerHeight;
    for (const el of pipelines) {
      const r = el.getBoundingClientRect();
      const mid = r.top + r.height / 2;
      const p = Math.min(1, Math.max(0, (vh * 0.85 - mid) / (vh * 0.45)));
      el.style.setProperty('--p', p.toFixed(3));
      const vertical = getComputedStyle(el).gridAutoFlow.startsWith('row');
      const items = [...el.children] as HTMLElement[];
      const pos = (li: HTMLElement) => (vertical ? li.offsetTop : li.offsetLeft);
      const rail = pos(items[items.length - 1]) - pos(items[0]);
      el.style.setProperty('--rail', `${rail}px`);
      el.dataset.rail = '';
      for (const li of items) {
        const at = rail > 0 ? (pos(li) - pos(items[0])) / rail : 0;
        li.classList.toggle('on', p > 0 && p >= at - 0.001);
      }
    }
  };
  const queueSteps = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(paintSteps);
    }
  };
  if (pipelines.length) {
    addEventListener('scroll', queueSteps, { passive: true });
    addEventListener('resize', queueSteps);
    paintSteps();
  }
</script>
