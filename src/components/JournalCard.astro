---
import { render } from 'astro:content';
import Spotify from './Spotify.astro';
import { extraFields, fmtDay, fmtDate, entryUrl, type Journal } from '../lib/collections';

interface Props {
  entry: Journal;
  /** Link the date to the entry's own page. */
  link?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { entry, link = true, headingLevel = 'h2' } = Astro.props;
const { date, quote, spotify, note } = entry.data;
const { Content } = await render(entry as never);
const hasBody = !!entry.body?.trim();
const day = fmtDay(date);
const extras = extraFields(entry);
const H = headingLevel;
const pageUrl = entryUrl(entry);
---

<article class="daily">
  <header class="d-head">
    <time class="d-date" datetime={date.toISOString().slice(0, 10)}>
      <span class="d-day">{day.day}</span>
      <span class="mono muted">{day.weekday} · {day.month}</span>
    </time>
    <H class="sr-only">{fmtDate(date)}</H>
    {extras.length > 0 && (
      <ul class="d-extras mono">
        {extras.map((x) => (
          <li>
            <span class="muted">{x.label}</span> {x.value}
          </li>
        ))}
      </ul>
    )}
  </header>

  {
    quote && (
      <figure class="d-quote">
        <blockquote>{quote.text}</blockquote>
        {quote.author && <figcaption class="mono">— {quote.author}</figcaption>}
      </figure>
    )
  }
  {spotify && <Spotify src={spotify} />}
  {note && <p class="d-note">{note}</p>}
  {
    hasBody && (
      <div class="d-body">
        <Content />
      </div>
    )
  }
  {
    link && (
      <a class="d-perma mono" href={pageUrl}>
        Permalink <span aria-hidden="true">→</span>
      </a>
    )
  }
</article>

<style>
  .daily {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    transition: border-color 0.3s;
  }
  .daily:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }
  .d-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .d-date {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
  }
  .d-day {
    font-family: var(--serif);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .d-extras {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.66rem;
  }
  .d-extras li {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-2);
  }
  .d-quote {
    margin: 0;
    padding-left: 1.2rem;
    border-left: 2px solid var(--accent);
  }
  blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  blockquote::before {
    content: '“';
    color: var(--accent);
  }
  blockquote::after {
    content: '”';
    color: var(--accent);
  }
  figcaption {
    margin-top: 0.6rem;
    color: var(--muted);
    text-transform: none;
  }
  .d-note,
  .d-body {
    margin: 0;
    color: var(--ink-2);
  }
  .d-body :global(p) {
    margin: 0 0 0.8rem;
  }
  .d-perma {
    align-self: flex-start;
    font-size: 0.68rem;
    color: var(--muted);
    text-decoration: none;
  }
  .d-perma:hover {
    color: var(--accent);
  }
</style>
