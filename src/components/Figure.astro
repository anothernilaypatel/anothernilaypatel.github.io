---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class="fig" data-reveal>
  <button type="button" class="fig-frame" data-zoom aria-label={`Enlarge figure: ${caption ?? alt}`}>
    <Image src={src} alt={alt} widths={[640, 960, 1280]} sizes="(max-width: 800px) 100vw, 760px" />
    <span class="fig-zoom mono" aria-hidden="true">⤢ enlarge</span>
  </button>
  {caption && <figcaption><span class="mono fig-n" data-fig-n></span>{caption}</figcaption>}
  <dialog class="fig-dialog">
    <form method="dialog"><button class="fig-close mono" aria-label="Close">close ✕</button></form>
    <Image src={src} alt={alt} widths={[1280, src.width]} sizes="95vw" />
  </dialog>
</figure>

<style>
  .fig {
    margin: 2.5rem 0;
  }
  .fig-frame {
    position: relative;
    display: block;
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
    cursor: zoom-in;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  .fig-frame:hover {
    transform: translateY(-3px);
    box-shadow: 0 24px 60px -30px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .fig-frame :global(img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .fig-zoom {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: #111;
    color: #eee;
    font-size: 0.65rem;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .fig-frame:hover .fig-zoom,
  .fig-frame:focus-visible .fig-zoom {
    opacity: 1;
  }
  figcaption {
    margin-top: 0.8rem;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .fig-n {
    color: var(--accent);
    margin-right: 0.6rem;
  }
  .fig-dialog {
    max-width: 96vw;
    max-height: 94vh;
    padding: 1rem;
    border: 0;
    border-radius: 10px;
    background: var(--paper);
  }
  .fig-dialog::backdrop {
    background: rgb(0 0 0 / 0.8);
    backdrop-filter: blur(4px);
  }
  .fig-dialog :global(img) {
    max-height: calc(94vh - 4rem);
    width: auto;
    margin: 0 auto;
  }
  .fig-close {
    display: block;
    margin: 0 0 0.6rem auto;
    border: 0;
    background: none;
    color: #222;
    cursor: pointer;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((btn, i) => {
    const fig = btn.closest('figure')!;
    const n = fig.querySelector('[data-fig-n]');
    if (n) n.textContent = `FIG.${String(i + 1).padStart(2, '0')}`;
    btn.addEventListener('click', () => fig.querySelector('dialog')?.showModal());
  });
</script>
