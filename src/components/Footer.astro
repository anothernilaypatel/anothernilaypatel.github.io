---
import { url } from '../lib/url';
import { site } from '../lib/config';
import { collections } from '../lib/collection-config';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap row">
    <span class="mono muted">© {year} {site.name}</span>
    <span class="mono muted">
      {collections.map((c) => <><a href={url(`/${c.name}/`)}>{c.title}</a> · </>)}
      <a href={url('/rss.xml')}>RSS</a> · <a href="https://github.com/anothernilaypatel">GitHub</a>
    </span>
  </div>
</footer>

<style>
  .foot {
    border-top: var(--hairline) solid var(--line);
    padding: 2rem 0 2.5rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
  }
  a {
    text-decoration: none;
  }
</style>
