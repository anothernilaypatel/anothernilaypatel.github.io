---
import { url, withoutBase } from '../lib/url';
import { site, sections } from '../lib/config';
import { isVisible } from '../lib/section-visibility';
import { collections } from '../lib/collection-config';

const current = withoutBase(Astro.url.pathname);
const anchors = sections
  .filter((s) => s.nav && isVisible(s))
  .map((s) => ({ href: url(`/#${s.id}`), label: s.nav! }));
const pills = collections
  .filter((c) => c.nav)
  .map((c) => ({ href: url(`/${c.name}/`), label: c.nav!, active: current.startsWith(`/${c.name}`) }));
---

<header class="nav" data-nav>
  <div class="wrap nav-inner">
    <a class="logo" href={url('/')} aria-label={`${site.name}, home`}>
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
        <rect x="1" y="1" width="30" height="30" rx="7" fill="none" stroke="currentColor" stroke-opacity=".35"></rect>
        <path d="M7 22 L12 14 L16 18 L21 9 L25 13" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span class="mono">{site.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          anchors.map((a) => (
            <li class="hide-sm">
              <a href={a.href}>{a.label}</a>
            </li>
          ))
        }
        {
          pills.map((p) => (
            <li>
              <a class:list={['blog-link', { active: p.active }]} href={p.href} aria-current={p.active ? 'page' : undefined}>
                <span class="dot" aria-hidden="true" />
                {p.label}
              </a>
            </li>
          ))
        }
        <li>
          <button class="theme" type="button" aria-label="Toggle light and dark theme" data-theme-toggle>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M12 7a5 5 0 0 1 0 10z" fill="currentColor"></path></svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    transition:
      background 0.4s var(--ease),
      border-color 0.4s var(--ease),
      transform 0.4s var(--ease);
    border-bottom: var(--hairline) solid transparent;
  }
  .nav.scrolled {
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(var(--blur-lg)) saturate(1.2);
    border-bottom-color: var(--line);
  }
  .nav.hidden {
    transform: translateY(-100%);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.25rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }
  ul {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li a {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
  }
  li a:hover {
    color: var(--ink);
  }
  .blog-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.95rem;
    border: var(--hairline) solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: var(--radius-pill);
    color: var(--ink);
    transition: background 0.3s var(--ease);
  }
  .blog-link:hover,
  .blog-link.active {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .dot {
    width: var(--dot-xs);
    height: var(--dot-xs);
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: var(--glow-pulse) transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .theme {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: var(--hairline) solid var(--line);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
  }
  .theme:hover {
    color: var(--ink);
    border-color: var(--ink-2);
  }
  @media (max-width: 720px) {
    .hide-sm {
      display: none;
    }
    ul {
      gap: 0.7rem;
    }
    .logo .mono {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  let last = scrollY;
  const onScroll = () => {
    const y = scrollY;
    nav.classList.toggle('scrolled', y > 24);
    nav.classList.toggle('hidden', y > 400 && y > last + 4);
    if (y < last - 4) nav.classList.remove('hidden');
    last = y;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  nav.addEventListener('focusin', () => nav.classList.remove('hidden'));

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    dispatchEvent(new Event('themechange'));
  });
</script>
