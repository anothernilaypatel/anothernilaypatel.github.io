---
import MarketField from '../components/MarketField.astro';
import { site, isPlaceholder } from '../site.config';
import { href } from '../lib/url';
import type { SectionProps } from '../lib/sections';

interface Props extends SectionProps {
  tagline?: string;
  /** Optional "Currently: …" line. */
  currently?: string;
  /** Buttons; entries with an empty href are hidden. The first `primary` one is filled. */
  buttons?: { label: string; href: string; primary?: boolean; icon?: string }[];
  note?: string;
}
const { id, kicker = `${site.handle} · about me`, tagline, currently, buttons = [], note = 'signal ← noise', animate } = Astro.props;
const [first, ...rest] = site.name.split(' ');
const shown = buttons.filter((b) => b.href);
---

<section id={id} class:list={['hero', { 'hero-anim': animate }]} data-hero={animate ? '' : undefined}>
  <MarketField converge={animate} paths={36} />
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="wrap hero-inner">
    <p class="kicker hero-kicker">{kicker}</p>
    <h1 class="hero-name">{first}<br /><span>{rest.join(' ')}</span></h1>
    {tagline && <p class="hero-tag">{tagline}</p>}
    {
      currently && (
        <p class:list={['mono', 'hero-now', { ph: isPlaceholder(currently) }]}>
          <span class="now-dot" aria-hidden="true" />
          Currently: {currently}
        </p>
      )
    }
    {
      shown.length > 0 && (
        <div class="hero-cta">
          {shown.map((b) => (
            <a class:list={['btn', { 'btn-primary': b.primary }]} href={href(b.href)}>
              {b.label} <span class="arrow" aria-hidden="true">{b.icon ?? '→'}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
  <div class="wrap hero-foot mono muted" aria-hidden="true">
    <span>scroll</span>
    <span class="scroll-line"></span>
    <span class="hero-note">{note}</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding-top: 5rem;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 70% at 18% 55%, color-mix(in srgb, var(--bg) 85%, transparent), transparent 70%),
      linear-gradient(to bottom, transparent 70%, var(--bg));
  }
  .hero-inner {
    position: relative;
    transform: translateY(calc(var(--hp, 0) * -80px));
    opacity: calc(1 - var(--hp, 0) * 1.2);
  }
  .hero-name {
    font-size: clamp(4.2rem, 15vw, 12.5rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    margin: 1.2rem 0 1.6rem;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
  }
  .hero-name span {
    font-style: italic;
    color: var(--accent);
    padding-left: 0.6em;
  }
  .hero-tag {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.3;
    max-width: 30ch;
    margin: 0 0 1.4rem;
    color: var(--ink-2);
  }
  .hero-now {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-transform: none;
    color: var(--ink-2);
    margin: 0 0 2.2rem;
    padding: 0.2rem 0.4rem;
  }
  .now-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--up);
    box-shadow: 0 0 12px var(--up);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .hero-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.6rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .scroll-line {
    width: 60px;
    height: 1px;
    background: var(--muted);
    transform-origin: left;
    animation: scrollhint 2.2s var(--ease) infinite;
  }
  .hero-note {
    margin-left: auto;
  }
  @keyframes scrollhint {
    0% {
      transform: scaleX(0);
    }
    60% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }
  :global(.js) .hero-anim .hero-inner > * {
    animation: rise 1.1s var(--ease) both;
  }
  :global(.js) .hero-anim .hero-inner > :nth-child(2) {
    animation-delay: 0.08s;
  }
  :global(.js) .hero-anim .hero-inner > :nth-child(3) {
    animation-delay: 0.2s;
  }
  :global(.js) .hero-anim .hero-inner > :nth-child(4) {
    animation-delay: 0.3s;
  }
  :global(.js) .hero-anim .hero-inner > :nth-child(5) {
    animation-delay: 0.4s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40px);
      filter: blur(6px);
    }
  }

  @media (max-width: 860px) {
    .hero-note {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-inner {
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          hero.style.setProperty('--hp', Math.min(1, Math.max(0, scrollY / hero.offsetHeight)).toFixed(3));
        });
      },
      { passive: true },
    );
  }
</script>
