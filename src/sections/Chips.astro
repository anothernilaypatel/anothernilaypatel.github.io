---
import SectionHead from '../components/section/SectionHead.astro';
import { isPlaceholder } from '../lib/config';
import { reveal, type SectionProps } from '../lib/section-utils';

interface Props extends SectionProps {
  /** Labeled groups of short items, shown as chips (e.g. skills, tools, languages). */
  groups: { label: string; items: string[] }[];
}
const { id, kicker, title, intro, groups = [], animate } = Astro.props;
const shown = groups.filter((g) => g.items.length > 0);
---

<section id={id} class:list={['sec', 'skills', { anim: animate }]} aria-labelledby={title ? `${id}-h` : undefined}>
  <div class="wrap">
    <SectionHead id={id} kicker={kicker} title={title} intro={intro} animate={animate} />
    <dl class="groups">
      {
        shown.map((g, gi) => (
          <div class="group" {...reveal(animate, gi)}>
            <dt class="mono">{g.label}</dt>
            <dd>
              <ul>
                {g.items.map((s, i) => (
                  <li class:list={['chip', { ph: isPlaceholder(s) }]} style={`--i:${i}`}>
                    {s}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .skills {
    padding: clamp(3.5rem, 8vw, 6rem) 0;
    background: linear-gradient(to bottom, transparent, var(--bg-2) 30%, var(--bg-2) 70%, transparent);
  }
  .groups {
    margin: 0;
    border-top: var(--hairline) solid var(--line);
  }
  .group {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1rem 2rem;
    align-items: baseline;
    padding: 1.4rem 0;
    border-bottom: var(--hairline) solid var(--line);
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chip {
    padding: 0.45rem 0.95rem;
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-pill);
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--ink);
    background: var(--surface);
    transition:
      transform 0.35s var(--ease),
      border-color 0.35s,
      color 0.35s;
  }
  .chip:hover {
    transform: translateY(var(--lift-lg)) rotate(-1.5deg);
    border-color: var(--accent);
    color: var(--accent);
  }
  :global(.js) .anim .group .chip {
    opacity: 0;
    transform: translateY(var(--reveal-sm));
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease),
      border-color 0.35s,
      color 0.35s;
    transition-delay: calc(var(--i) * 50ms + 150ms), calc(var(--i) * 50ms + 150ms), 0s, 0s;
  }
  :global(.js) .group.is-in .chip {
    opacity: 1;
    transform: none;
  }
  :global(.js) .group.is-in .chip:hover {
    transform: translateY(var(--lift-lg)) rotate(-1.5deg);
    transition-delay: 0s;
  }
  @media (max-width: 720px) {
    .group {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .anim .group .chip {
      opacity: 1;
      transform: none;
    }
  }
</style>