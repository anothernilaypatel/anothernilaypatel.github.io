---
/**
 * Example section type. Files starting with "_" are ignored, so this one is not registered.
 *
 * To make your own (two files, same name):
 *   1. Copy this file to src/sections/Quote.astro and _Example.schema.ts to src/sections/Quote.schema.ts.
 *      The file name becomes the type: Quote -> 'quote', CardGrid -> 'card-grid'.
 *   2. List every field in the schema file, and use the same fields in Props below.
 *   3. Style only with tokens (var(--…)) from src/styles/tokens.css. See STYLE.md.
 *   4. Add an entry to `sections` in src/site.config.ts:
 *        { type: 'quote', id: 'motto', animate: true, kicker: 'Motto', text: 'Stay curious.', author: 'Me' },
 *   5. Run npm run check.
 */
import SectionHead from '../components/section/SectionHead.astro';
import { reveal, type SectionProps } from '../lib/section-utils';

// SectionProps gives you id, animate, kicker, title, and intro. Add your own fields here.
interface Props extends SectionProps {
  text: string;
  author?: string;
}
const { id, kicker, title, intro, text, author, animate } = Astro.props;
---

<section id={id} class="sec sec-pad quote" aria-labelledby={title ? `${id}-h` : undefined}>
  <div class="wrap">
    <!-- Numbered kicker + heading, same look as every other section. -->
    <SectionHead id={id} kicker={kicker} title={title} intro={intro} animate={animate} />

    <!-- reveal(animate, delay) adds the fade-up-on-scroll animation only when `animate: true`. -->
    <figure {...reveal(animate, 1)}>
      <blockquote>{text}</blockquote>
      {author && <figcaption class="mono muted">— {author}</figcaption>}
    </figure>
  </div>
</section>

<style>
  /* Styles here only apply to this section. Theme colors: var(--ink), var(--accent), var(--surface), var(--line). */
  blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.2;
    color: var(--ink);
    border-left: var(--rule) solid var(--accent);
    padding-left: 1.2rem;
  }
  figcaption {
    margin-top: 1rem;
  }
</style>
