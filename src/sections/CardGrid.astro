---
import SectionHead from '../components/section/SectionHead.astro';
import Sparkline from '../components/Sparkline.astro';
import { isPlaceholder } from '../site.config';
import { href as siteHref } from '../lib/url';
import { resolveRef } from '../lib/collections';
import type { SectionProps } from '../lib/sections';

interface Card {
  title: string;
  text?: string;
  badge?: string;
  /** Link: a site path ('/projects/x/') or a full URL. */
  href?: string;
  /** Link to a post, e.g. 'projects/coffee'. Only links once that post is published. */
  ref?: string;
  linkLabel?: string;
}
interface Props extends SectionProps {
  items: Card[];
  /** 'grid' wraps cards in rows; 'strip' is one horizontal row (pinned to scroll when `animate` is on). */
  layout?: 'grid' | 'strip';
  /** Decorative sparkline at the bottom of each card. */
  sparkline?: boolean;
  /** Small hint next to the heading in strip layout. */
  hint?: string;
}
const { id, kicker, title, intro, items = [], layout = 'grid', sparkline = true, hint = 'scroll', animate } = Astro.props;
const cards = await Promise.all(
  items.map(async (c) => ({ ...c, link: c.href ? siteHref(c.href) : await resolveRef(c.ref) })),
);
const pinned = layout === 'strip' && animate;
---

<section
  id={id}
  class:list={['sec', 'int', `layout-${layout}`]}
  aria-labelledby={title ? `${id}-h` : undefined}
  data-hs={pinned ? '' : undefined}>
  <div class="int-sticky">
    <div class="wrap int-head">
      <SectionHead id={id} kicker={kicker} title={title} intro={intro} animate={animate} />
      {layout === 'strip' && hint && (
        <p class="mono muted int-hint" aria-hidden="true">
          {hint} <span>→</span>
        </p>
      )}
    </div>
    <div class:list={['int-viewport', { wrap: layout === 'grid' }]} data-hs-viewport>
      <ul class="int-track" data-hs-track>
        {
          cards.map((it, i) => (
            <li class="int-card" data-tilt>
              <div class="int-top mono">
                <span class="muted">{String(i + 1).padStart(2, '0')}</span>
                {it.badge && <span class="badge">{it.badge}</span>}
              </div>
              <h3>{it.title}</h3>
              {it.text && <p class:list={['int-blurb', { ph: isPlaceholder(it.text) }]}>{it.text}</p>}
              {sparkline && <Sparkline seed={it.title} width={300} height={54} class="int-spark draw" />}
              {it.link && (
                <a class="int-link mono" href={it.link}>
                  {it.linkLabel ?? (it.ref && !it.href ? 'Read the post' : 'Open')} <span aria-hidden="true">→</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
    {pinned && <div class="wrap int-progress" aria-hidden="true"><span data-hs-bar /></div>}
  </div>
</section>

<style>
  .int {
    padding: clamp(3.5rem, 8vw, 6rem) 0;
  }
  .int-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 2.2rem;
  }
  .int-head :global(.sec-head) {
    margin-bottom: 0;
  }
  .int-hint span {
    display: inline-block;
    animation: nudge 1.8s var(--ease) infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateX(6px);
    }
  }
  .int-viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .int-viewport::-webkit-scrollbar {
    display: none;
  }
  .int-track {
    --pad: calc((100vw - min(1180px, 100vw - 2.5rem)) / 2);
    display: flex;
    gap: 1.25rem;
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--pad) 1rem;
    perspective: 1200px;
    will-change: transform;
  }
  .int-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: min(78vw, 340px);
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
    scroll-snap-align: center;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.5s var(--ease),
      border-color 0.3s;
  }
  .int-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(380px circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--accent) 12%, transparent), transparent 40%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .int-card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
  }
  .int-card:hover::after {
    opacity: 1;
  }
  .int-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .badge {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.68rem;
  }
  .layout-grid .int-track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    width: auto;
    padding: 0.5rem 0 1rem;
  }
  .layout-grid .int-viewport {
    overflow: visible;
  }
  .layout-grid .int-card {
    width: auto;
  }
  .int-card h3 {
    font-size: 1.9rem;
  }
  .int-blurb {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.98rem;
    padding: 0.1rem 0.3rem;
    margin-left: -0.3rem;
  }
  :global(.int-spark) {
    margin-top: auto;
    padding-top: 0.8rem;
  }
  .int-link {
    color: var(--accent);
    text-decoration: none;
  }
  .int-link::before {
    content: '';
    position: absolute;
    inset: 0;
  }
  .int-progress {
    height: 2px;
    margin-top: 1.5rem;
    background: var(--line);
    display: none;
  }
  .int-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }

  /* Pinned mode (wide screens, motion allowed, cards overflow): vertical scroll drives the strip. */
  .int.hs-on {
    padding: 0;
  }
  .int.hs-on .int-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .int.hs-on .int-viewport {
    overflow: visible;
    scroll-snap-type: none;
  }
  .int.hs-on .int-track {
    transform: translate3d(var(--x, 0px), 0, 0);
  }
  .int.hs-on .int-progress {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .int-hint span {
      animation: none;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-hs]').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-hs-track]')!;
    const viewport = section.querySelector<HTMLElement>('[data-hs-viewport]')!;
    const bar = section.querySelector<HTMLElement>('[data-hs-bar]');
    let overflow = 0;
    let on = false;

    const progress = () => {
      const r = section.getBoundingClientRect();
      const span = r.height - innerHeight;
      return span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : 0;
    };
    const paint = () => {
      if (!on) return;
      const p = progress();
      track.style.setProperty('--x', `${(-p * overflow).toFixed(1)}px`);
      bar?.style.setProperty('--p', p.toFixed(3));
    };
    const layout = () => {
      section.classList.remove('hs-on');
      section.style.height = '';
      overflow = track.offsetWidth - viewport.clientWidth;
      on = !reduce.matches && innerWidth >= 900 && overflow > 40;
      if (on) {
        section.classList.add('hs-on');
        section.style.height = `${innerHeight + overflow}px`;
      }
      paint();
    };

    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            paint();
          });
        }
      },
      { passive: true },
    );
    addEventListener('resize', layout);
    reduce.addEventListener('change', layout);
    document.fonts?.ready.then(layout);
    layout();

    // Keep keyboard focus visible: scroll the page so the focused card is on screen.
    track.addEventListener('focusin', (e) => {
      if (!on) return;
      const card = (e.target as HTMLElement).closest<HTMLElement>('.int-card');
      if (!card) return;
      const p = Math.min(1, Math.max(0, (card.offsetLeft - viewport.clientWidth / 2 + card.offsetWidth / 2) / overflow));
      const top = section.getBoundingClientRect().top + scrollY;
      scrollTo({ top: top + p * (section.offsetHeight - innerHeight), behavior: 'instant' as ScrollBehavior });
    });
  });

  if (!reduce.matches && matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLElement>('.int-card[data-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height;
        card.style.setProperty('--ry', `${(x - 0.5) * 8}deg`);
        card.style.setProperty('--rx', `${(0.5 - y) * 8}deg`);
        card.style.setProperty('--mx', `${x * 100}%`);
        card.style.setProperty('--my', `${y * 100}%`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }
</script>
