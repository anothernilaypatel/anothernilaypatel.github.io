---
import SectionHead from '../components/section/SectionHead.astro';
import Sparkline from '../components/Sparkline.astro';
import { isPlaceholder } from '../lib/config';
import { href as siteHref } from '../lib/url';
import { resolveRef } from '../lib/collections';
import type { SectionProps } from '../lib/section-utils';

interface Card {
  title: string;
  text?: string;
  badge?: string;
  /** Link: a site path ('/projects/x/') or a full URL. */
  href?: string;
  /** Link to a post, e.g. 'projects/coffee'. Only links once that post is published. */
  ref?: string;
  linkLabel?: string;
}
interface Props extends SectionProps {
  items: Card[];
  /** 'grid' wraps cards in rows; 'strip' is one horizontal row (pinned to scroll when `animate` is on). */
  layout?: 'grid' | 'strip';
  /** Decorative sparkline at the bottom of each card. */
  sparkline?: boolean;
  /** Small hint next to the heading in strip layout. */
  hint?: string;
}
const { id, kicker, title, intro, items = [], layout = 'grid', sparkline = true, hint = 'scroll', animate } = Astro.props;
const cards = await Promise.all(
  items.map(async (c) => ({ ...c, link: c.href ? siteHref(c.href) : await resolveRef(c.ref) })),
);
const pinned = layout === 'strip' && animate;
---

<section
  id={id}
  class:list={['sec', 'int', `layout-${layout}`]}
  aria-labelledby={title ? `${id}-h` : undefined}
  data-hs={pinned ? '' : undefined}>
  <div class="int-sticky">
    <div class="wrap int-head">
      <SectionHead id={id} kicker={kicker} title={title} intro={intro} animate={animate} />
      {layout === 'strip' && hint && (
        <p class="mono muted int-hint" aria-hidden="true">
          {hint} <span>→</span>
        </p>
      )}
    </div>
    <div class:list={['int-viewport', { wrap: layout === 'grid' }]} data-hs-viewport>
      <ul class="int-track" data-hs-track>
        {
          cards.map((it, i) => (
            <li class="int-card" data-tilt>
              <div class="int-top mono">
                <span class="muted">{String(i + 1).padStart(2, '0')}</span>
                {it.badge && <span class="badge">{it.badge}</span>}
              </div>
              <h3>{it.title}</h3>
              {it.text && <p class:list={['int-blurb', { ph: isPlaceholder(it.text) }]}>{it.text}</p>}
              {sparkline && <Sparkline seed={it.title} width={300} height={54} class="int-spark draw" />}
              {it.link && (
                <a class="int-link mono" href={it.link}>
                  {it.linkLabel ?? (it.ref && !it.href ? 'Read the post' : 'Open')} <span aria-hidden="true">→</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
    {pinned && <div class="wrap int-progress" aria-hidden="true"><span data-hs-bar /></div>}
  </div>
</section>

<style>
  .int {
    padding: clamp(3.5rem, 8vw, 6rem) 0;
  }
  .int-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 2.2rem;
  }
  .int-head :global(.sec-head) {
    margin-bottom: 0;
  }
  .int-hint span {
    display: inline-block;
    animation: nudge 1.8s var(--ease) infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateX(var(--nudge));
    }
  }
  .int-viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .int-viewport::-webkit-scrollbar {
    display: none;
  }
  .int-track {
    --pad: calc((100vw - min(var(--wrap-max), 100vw - 2.5rem)) / 2);
    display: flex;
    gap: 1.25rem;
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--pad) 1rem;
    perspective: var(--perspective);
    will-change: transform;
  }
  .int-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    width: min(78vw, var(--strip-card));
    padding: 1.6rem;
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius-card-lg);
    background: var(--surface);
    scroll-snap-align: center;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 0.5s var(--ease),
      border-color 0.3s;
  }
  .int-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(var(--spotlight-sm) circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--accent) 12%, transparent), transparent 40%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .int-card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
  }
  .int-card:hover::after {
    opacity: 1;
  }
  .int-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .badge {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.68rem;
  }
  .layout-grid .int-track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min)), 1fr));
    width: auto;
    padding: 0.5rem 0 1rem;
  }
  .layout-grid .int-viewport {
    overflow: visible;
  }
  .layout-grid .int-card {
    width: auto;
  }
  .int-card h3 {
    font-size: 1.9rem;
  }
  .int-blurb {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.98rem;
    padding: 0.1rem 0.3rem;
    margin-left: -0.3rem;
  }
  :global(.int-spark) {
    margin-top: auto;
    padding-top: 0.8rem;
  }
  .int-link {
    color: var(--accent);
    text-decoration: none;
  }
  .int-link::before {
    content: '';
    position: absolute;
    inset: 0;
  }
  .int-progress {
    height: var(--rule);
    margin-top: 1.5rem;
    background: var(--line);
    display: none;
  }
  .int-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }

  /* Pinned mode (wide screens, motion allowed, cards overflow): vertical scroll drives the strip. */
  .int.hs-on {
    padding: 0;
  }
  .int.hs-on .int-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .int.hs-on .int-viewport {
    overflow: visible;
    scroll-snap-type: none;
  }
  .int.hs-on .int-track {
    transform: translate3d(var(--x, 0), 0, 0);
  }
  .int.hs-on .int-progress {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .int-hint span {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/motion/pinned-strip';
  import '../scripts/motion/tilt';
</script>
