---
import SectionHead from '../components/section/SectionHead.astro';
import { isPlaceholder } from '../lib/config';
import { href } from '../lib/url';
import { reveal, type SectionProps } from '../lib/section-utils';

interface Props extends SectionProps {
  /** Big headline cards. With `animate`, numbers in `value` count in (e.g. "Top 50" counts down). */
  items: { value: string; label: string; detail?: string; href?: string }[];
}
const { id, kicker, title, intro, items = [], animate } = Astro.props;
---

<section id={id} class="sec hl" aria-label={title ?? kicker ?? 'Highlights'}>
  <div class="wrap">
    <SectionHead id={id} kicker={kicker} title={title} intro={intro} animate={animate} />
    <ul class="hl-list">
      {
        items.map((h, i) => {
          const Tag = h.href ? 'a' : 'div';
          return (
            <li {...reveal(animate, i)}>
              <Tag class="hl-card" href={h.href ? href(h.href) : undefined} data-spotlight>
                <span class="hl-value" data-countdown={animate ? h.value : undefined}>
                  {h.value}
                </span>
                <span class="hl-label">{h.label}</span>
                {h.detail && <span class:list={['hl-detail', { ph: isPlaceholder(h.detail) }]}>{h.detail}</span>}
                <span class="hl-glow" aria-hidden="true" />
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .hl {
    padding: clamp(3rem, 7vw, 5rem) 0;
  }
  .hl :global(.sec-head) {
    margin-bottom: 0;
  }
  .hl-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min-lg)), 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .hl-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: clamp(1.6rem, 4vw, 2.6rem);
    border: var(--hairline) solid color-mix(in srgb, var(--accent) 40%, var(--line));
    border-radius: var(--radius-feature);
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 55%),
      var(--surface);
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
  }
  .hl-card:hover {
    color: var(--ink);
  }
  .hl-value {
    font-family: var(--serif);
    font-size: clamp(4rem, 12vw, 8.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
  }
  .hl-label {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    line-height: 1.1;
  }
  .hl-detail {
    color: var(--ink-2);
    max-width: 34rem;
    padding: 0.15rem 0.35rem;
    margin-left: -0.35rem;
  }
  .hl-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(var(--spotlight) circle at var(--mx, 80%) var(--my, 20%), color-mix(in srgb, var(--accent) 14%, transparent), transparent 45%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .hl-card:hover .hl-glow {
    opacity: 1;
  }
</style>

<script>
  import '../scripts/motion/spotlight';
  import '../scripts/motion/countdown';
</script>
