---
import SectionHead from '../components/section/SectionHead.astro';
import { isPlaceholder } from '../lib/config';
import { href } from '../lib/url';
import { reveal, type SectionProps } from '../lib/section-utils';

type Item = { title: string; sub?: string; period?: string; detail?: string; href?: string };
interface Props extends SectionProps {
  /** Groups shown top to bottom (e.g. Experience, Education). Empty groups are skipped. */
  groups: { label?: string; items: Item[] }[];
}
const { id, kicker, title, intro, groups = [], animate } = Astro.props;
const shown = groups.filter((g) => g.items.length > 0);
const ph = (s?: string) => isPlaceholder(s);
---

<section id={id} class="sec path" aria-labelledby={title ? `${id}-h` : undefined}>
  <div class="wrap path-grid">
    <SectionHead id={id} kicker={kicker} title={title} intro={intro} animate={animate} class="path-head" />
    <div class="tl" data-fill-track={animate ? '' : undefined}>
      <div class="tl-rail" aria-hidden="true"><span data-fill></span></div>
      {
        shown.map((g) => (
          <div class="tl-group">
            {g.label && (
              <h3 class="mono tl-label" {...reveal(animate)}>
                {g.label}
              </h3>
            )}
            <ol>
              {g.items.map((it, i) => (
                <li class:list={['tl-item', { 'is-in': !animate }]} {...reveal(animate, i)}>
                  <span class="tl-dot" aria-hidden="true" />
                  {it.period && <p class:list={['mono', 'tl-period', { ph: ph(it.period) }]}>{it.period}</p>}
                  <p class:list={['tl-title', { ph: ph(it.title) }]}>
                    {it.href ? <a href={href(it.href)}>{it.title}</a> : it.title}
                  </p>
                  {it.sub && <p class:list={['tl-sub', { ph: ph(it.sub) }]}>{it.sub}</p>}
                  {it.detail && <p class:list={['tl-detail', { ph: ph(it.detail) }]}>{it.detail}</p>}
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .path {
    padding: clamp(3.5rem, 8vw, 6rem) 0;
  }
  .path-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 6rem);
  }
  .path-grid :global(.path-head) {
    position: sticky;
    top: 7rem;
    align-self: start;
  }

  .tl {
    position: relative;
    padding-left: 2.2rem;
  }
  .tl-rail {
    position: absolute;
    left: 0.4rem;
    top: 0.4rem;
    bottom: 0.4rem;
    width: var(--hairline);
    background: var(--line);
  }
  .tl-rail span {
    display: block;
    --p: 1;
    height: calc(var(--p) * 100%);
    background: linear-gradient(to bottom, var(--accent), color-mix(in srgb, var(--accent) 30%, transparent));
    box-shadow: var(--glow-sm) var(--accent);
  }
  .tl-group + .tl-group {
    margin-top: 2.5rem;
  }
  .tl-label {
    margin: 0 0 1rem;
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--accent);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .tl-item {
    position: relative;
  }
  .tl-item p {
    margin: 0;
  }
  .tl-dot {
    position: absolute;
    left: calc(-2.2rem + 0.4rem - var(--dot-lg-half));
    top: 0.3rem;
    width: var(--dot-lg);
    height: var(--dot-lg);
    border-radius: 50%;
    border: var(--hairline) solid var(--muted);
    background: var(--bg);
    transition: all 0.4s;
  }
  .tl-item.is-in .tl-dot {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: var(--glow) var(--accent);
  }
  .tl-period {
    color: var(--muted);
    margin-bottom: 0.35rem !important;
  }
  .tl-title {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    line-height: 1.15;
  }
  .tl-title a {
    text-decoration-color: var(--accent);
  }
  .tl-sub {
    color: var(--ink-2);
  }
  .tl-detail {
    color: var(--muted);
    font-size: 0.95rem;
    margin-top: 0.4rem !important;
    max-width: 36rem;
  }
  .ph {
    display: inline-block;
    padding: 0 0.3rem;
  }
  @media (max-width: 860px) {
    .path-grid {
      grid-template-columns: 1fr;
    }
    .path-grid :global(.path-head) {
      position: static;
    }
  }
</style>

<script>
  import '../scripts/motion/scroll-fill';
</script>
